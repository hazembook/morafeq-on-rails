# Development environment variables template
# Copy this to .env (already gitignored) or .env.local for local overrides
# For production secrets, use Rails credentials or your deployment env vars.

# Database URL (Rails 8 uses SQLite by default)
# DATABASE_URL=sqlite3:///storage/production.sqlite3

# Application host (used by password reset mailer)
# APP_HOST=localhost:3000

# Sentry DSN (for Phase 8)
# SENTRY_DSN=
