# Development environment variables template
# Copy this to .env (already gitignored) or .env.local for local overrides
# For production secrets, use Rails credentials or your deployment env vars.

# Database URL (Rails 8 uses SQLite by default)
# DATABASE_URL=sqlite3:///storage/production.sqlite3

# Application host (used by password reset mailer)
# APP_HOST=localhost:3000

# Sentry DSN (for Phase 8)
# SENTRY_DSN=

# --- Kamal Deployment ---

# Target server IP (KVM VM created via kdeploy)
# MORAFEQ_SERVER_IP=192.168.122.100

# Public-facing domain (used by password reset mailer in production)
# APP_HOST=morafeq.yourdomain.com

# Container registry credentials
# For GitHub Container Registry: create a PAT with write:packages scope
# KAMAL_REGISTRY_PASSWORD=ghp_...

# Rails master key (copy from config/master.key)
# RAILS_MASTER_KEY=...
