#!/bin/bash -e

# If running the rails server then create or migrate existing database
if [ "${@: -2:1}" == "./bin/rails" ] && [ "${@: -1:1}" == "server" ]; then
  ./bin/rails db:prepare

  # Auto-populate demo environment with seed data on first boot
  if [ "$RAILS_ENV" == "demo" ]; then
    ./bin/rails runner "exit(1) unless User.exists?(email_address: 'admin@morafeq.edu')" || ./bin/rails demo:seed
  fi
fi

exec "${@}"
