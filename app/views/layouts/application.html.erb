<!DOCTYPE html>
<html lang="<%= I18n.locale %>" dir="<%= I18n.locale == :ar ? "rtl" : "ltr" %>">
  <head>
    <title><%= content_for(:title) || t("app_name") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="<%= t("app_name") %>">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>

    <link rel="icon" href="/morafeq-logo.png" type="image/png">
    <%# <link rel="icon" href="/icon.svg" type="image/svg+xml"> %>
    <link rel="apple-touch-icon" href="/morafeq-logo.png">
    <link rel="manifest" href="<%= pwa_manifest_path %>">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body data-controller="lightbox-gallery" class="bg-gray-50 <%= content_for?(:body_class) ? yield(:body_class) : "pb-16 md:pb-0" %>" style="<%= content_for?(:body_style) ? yield(:body_style) : "padding-bottom: calc(4rem + env(safe-area-inset-bottom, 0px))" %>">
    <%# Staging banner %>
    <div class="bg-amber-400 text-amber-900 text-xs text-center py-1 px-2 font-semibold select-none" style="padding-top: calc(0.25rem + env(safe-area-inset-top, 0px))">
      ⚠️ <%= t("staging_banner") %>
    </div>

    <%# Desktop top nav %>
    <nav class="hidden md:block bg-white border-b border-gray-200 fixed top-0 w-full z-50">
      <div class="max-w-5xl mx-auto px-4 h-16 flex items-center justify-between">
        <div class="flex items-center gap-6">
          <%= link_to t("app_name"), root_path, class: "text-xl font-bold text-blue-600" %>
          <% if authenticated? %>
            <%= link_to t("nav.home"), feed_index_path, class: "text-sm text-gray-600 hover:text-gray-900" %>
            <% unless Current.user.admin? %>
              <%= link_to t("nav.subjects"), subjects_path, class: "text-sm text-gray-600 hover:text-gray-900" %>
            <% end %>
            <%= link_to t("nav.chats"), chat_rooms_path, class: "text-sm text-gray-600 hover:text-gray-900" %>
            <%= link_to t("nav.profile"), profile_path, class: "text-sm text-gray-600 hover:text-gray-900" %>
          <% end %>
        </div>
        <div class="flex items-center gap-4">
          <%# Locale Switcher %>
          <% if I18n.locale == :ar %>
            <%= link_to "English", url_for(locale: :en), data: { turbo: false }, class: "text-xs font-semibold text-gray-600 hover:text-gray-900 px-2 py-1 rounded bg-gray-100 hover:bg-gray-200 transition" %>
          <% else %>
            <%= link_to "العربية", url_for(locale: :ar), data: { turbo: false }, class: "text-xs font-semibold text-gray-600 hover:text-gray-900 px-2 py-1 rounded bg-gray-100 hover:bg-gray-200 transition" %>
          <% end %>

          <% if authenticated? %>
            <% if Current.user.admin? %>
              <%= link_to t("nav.admin"), admin_path, class: "text-sm text-gray-600 hover:text-gray-900" %>
            <% end %>
            <span class="text-sm text-gray-500"><%= Current.user.full_name %></span>
            <%= button_to t("nav.sign_out"), session_path, method: :delete, class: "text-sm text-gray-600 hover:text-gray-900" %>
          <% else %>
            <%= link_to t("nav.sign_in"), new_session_path, class: "text-sm text-gray-600 hover:text-gray-900" %>
          <% end %>
        </div>
      </div>
    </nav>

    <%# Flash messages %>
    <% if notice %>
      <div class="fixed top-4 left-1/2 -translate-x-1/2 z-50 bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded shadow-lg" role="alert">
        <%= notice %>
      </div>
    <% end %>
    <% if alert %>
      <div class="fixed top-4 left-1/2 -translate-x-1/2 z-50 bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded shadow-lg" role="alert">
        <%= alert %>
      </div>
    <% end %>

    <%# Main content %>
    <main class="<%= content_for?(:main_class) ? yield(:main_class) : "md:mt-20 mx-auto px-4 py-4" %>">
      <%= yield %>
    </main>

    <%# Mobile bottom tab bar %>
    <% if authenticated? %>
      <nav id="mobile-bottom-nav" class="md:hidden fixed bottom-0 w-full bg-white border-t border-gray-200 z-50" style="padding-bottom: env(safe-area-inset-bottom, 0px)">
        <div class="flex items-center justify-around h-16">
          <%= link_to feed_index_path, class: "flex flex-col items-center gap-0.5 px-3 py-1 #{current_page?(feed_index_path) ? 'text-blue-600' : 'text-gray-500'}" do %>
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
            <span class="text-xs"><%= t("nav.home") %></span>
          <% end %>
          <% unless Current.user.admin? %>
            <%= link_to subjects_path, class: "flex flex-col items-center gap-0.5 px-3 py-1 #{current_page?(subjects_path) ? 'text-blue-600' : 'text-gray-500'}" do %>
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
              <span class="text-xs"><%= t("nav.subjects") %></span>
            <% end %>
          <% end %>
          <%= link_to chat_rooms_path, class: "flex flex-col items-center gap-0.5 px-3 py-1 #{current_page?(chat_rooms_path) ? 'text-blue-600' : 'text-gray-500'}" do %>
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
            <span class="text-xs"><%= t("nav.chats") %></span>
          <% end %>
          <% if Current.user.admin? %>
            <%= link_to admin_path, class: "flex flex-col items-center gap-0.5 px-3 py-1 #{current_page?(controller: 'admin/dashboard') ? 'text-blue-600' : 'text-gray-500'}" do %>
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
              <span class="text-xs"><%= t("nav.admin") %></span>
            <% end %>
          <% end %>
          <%= link_to profile_path, class: "flex flex-col items-center gap-0.5 px-3 py-1 #{current_page?(profile_path) ? 'text-blue-600' : 'text-gray-500'}" do %>
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
            <span class="text-xs"><%= t("nav.profile") %></span>
          <% end %>
        </div>
      </nav>
    <% end %>

    <%# Global Media Lightbox Modal %>
    <div id="lightbox-modal" data-lightbox-gallery-target="modal" class="fixed inset-0 bg-black/95 z-[100] flex-col items-center justify-center p-4 cursor-zoom-out" style="display: none;" data-action="click->lightbox-gallery#closeBackdrop">
      <div id="lightbox-toolbar" class="w-full max-w-5xl flex items-center justify-between mb-2 text-white pointer-events-auto cursor-default shrink-0 select-none px-2" data-action="click->lightbox-gallery#stop">
        <div class="flex items-center gap-2 min-w-0">
          <svg id="lightbox-toolbar-icon" data-lightbox-gallery-target="toolbarIcon" class="w-5 h-5 shrink-0 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"></svg>
          <span id="lightbox-toolbar-title" data-lightbox-gallery-target="toolbarTitle" class="font-medium text-sm truncate"><%= t("lightbox.document_viewer") %></span>
          <span id="lightbox-toolbar-counter" data-lightbox-gallery-target="toolbarCounter" class="text-xs text-gray-400 bg-white/10 px-2 py-0.5 rounded ms-2" style="display: none;"></span>
        </div>
        <div class="flex items-center gap-2 shrink-0">
          <a id="lightbox-toolbar-action" data-lightbox-gallery-target="toolbarAction" href="" target="_blank" class="px-2.5 py-1.5 text-xs font-medium text-white bg-white/10 hover:bg-white/20 rounded border border-white/20 transition-colors flex items-center gap-1">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
            </svg>
            <span class="hidden sm:inline"><%= t("lightbox.open_new_tab") %></span>
          </a>
          <a id="lightbox-toolbar-download" data-lightbox-gallery-target="toolbarDownload" href="" download class="px-2.5 py-1.5 text-xs font-medium text-white bg-blue-600 hover:bg-blue-700 rounded border border-blue-500 transition-colors flex items-center gap-1">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
            </svg>
            <span class="hidden sm:inline"><%= t("lightbox.download") %></span>
          </a>
          <button class="text-white text-3xl font-light hover:text-gray-300 cursor-pointer w-8 h-8 flex items-center justify-center rounded-full hover:bg-white/10" data-action="click->lightbox-gallery#close">&times;</button>
        </div>
      </div>

      <div class="relative w-full flex-1 max-w-5xl max-h-[80vh] flex items-center justify-center pointer-events-none" data-action="click->lightbox-gallery#stop">
        <button id="lightbox-prev" data-lightbox-gallery-target="prevBtn" class="absolute start-4 top-1/2 -translate-y-1/2 text-white text-5xl font-light hover:text-gray-300 cursor-pointer pointer-events-auto bg-black/30 hover:bg-black/50 rounded-full w-12 h-12 flex items-center justify-center select-none transition-colors z-[102]" style="display: none;" data-action="click->lightbox-gallery#navigate:stopPropagation" data-lightbox-gallery-direction-param="<%= I18n.locale == :ar ? 1 : -1 %>"><%= I18n.locale == :ar ? "\u203A" : "\u2039" %></button>
        <button id="lightbox-next" data-lightbox-gallery-target="nextBtn" class="absolute end-4 top-1/2 -translate-y-1/2 text-white text-5xl font-light hover:text-gray-300 cursor-pointer pointer-events-auto bg-black/30 hover:bg-black/50 rounded-full w-12 h-12 flex items-center justify-center select-none transition-colors z-[102]" style="display: none;" data-action="click->lightbox-gallery#navigate:stopPropagation" data-lightbox-gallery-direction-param="<%= I18n.locale == :ar ? -1 : 1 %>"><%= I18n.locale == :ar ? "\u2039" : "\u203A" %></button>

        <img id="lightbox-img" data-lightbox-gallery-target="img" src="" class="hidden max-w-full max-h-full object-contain rounded shadow-2xl scale-95 opacity-0 transition-all duration-300 pointer-events-auto" style="display: none;">

        <iframe id="lightbox-pdf" data-lightbox-gallery-target="pdf" src="" class="hidden w-full h-full rounded shadow-2xl opacity-0 scale-95 transition-all duration-300 pointer-events-auto bg-white" style="display: none;"></iframe>

        <video id="lightbox-video" data-lightbox-gallery-target="video" src="" controls class="hidden max-w-full max-h-full rounded shadow-2xl opacity-0 scale-95 transition-all duration-300 pointer-events-auto" style="display: none;"></video>

        <div id="lightbox-audio-container" data-lightbox-gallery-target="audioContainer" class="hidden w-full max-w-md bg-white rounded-lg p-6 shadow-2xl opacity-0 scale-95 transition-all duration-300 pointer-events-auto flex flex-col items-center gap-4" style="display: none;">
          <svg class="w-16 h-16 text-blue-600 animate-pulse" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3"></path>
          </svg>
          <div class="text-sm font-medium text-gray-800 text-center truncate w-full" id="lightbox-audio-title" data-lightbox-gallery-target="audioTitle"><%= t("lightbox.audio_player") %></div>
          <audio id="lightbox-audio" data-lightbox-gallery-target="audio" src="" controls class="w-full"></audio>
        </div>
      </div>
    </div>
  </body>
</html>
