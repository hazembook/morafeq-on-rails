<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Morafeq" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Morafeq">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <link rel="manifest" href="<%= pwa_manifest_path %>">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-gray-50 pb-16 md:pb-0" style="padding-bottom: calc(4rem + env(safe-area-inset-bottom, 0px))">
    <%# Desktop top nav %>
    <nav class="hidden md:block bg-white border-b border-gray-200 fixed top-0 w-full z-50">
      <div class="max-w-5xl mx-auto px-4 h-16 flex items-center justify-between">
        <div class="flex items-center gap-6">
          <%= link_to "Morafeq", root_path, class: "text-xl font-bold text-blue-600" %>
          <% if authenticated? %>
            <%= link_to "Home", feed_index_path, class: "text-sm text-gray-600 hover:text-gray-900" %>
            <% unless Current.user.admin? %>
              <%= link_to "Subjects", subjects_path, class: "text-sm text-gray-600 hover:text-gray-900" %>
            <% end %>
            <%= link_to "Chats", chat_rooms_path, class: "text-sm text-gray-600 hover:text-gray-900" %>
            <%= link_to "Profile", profile_path, class: "text-sm text-gray-600 hover:text-gray-900" %>
          <% end %>
        </div>
        <div class="flex items-center gap-4">
          <% if authenticated? %>
            <% if Current.user.admin? %>
              <%= link_to "Admin", admin_path, class: "text-sm text-gray-600 hover:text-gray-900" %>
            <% end %>
            <span class="text-sm text-gray-500"><%= Current.user.full_name %></span>
            <%= button_to "Sign out", session_path, method: :delete, class: "text-sm text-gray-600 hover:text-gray-900" %>
          <% else %>
            <%= link_to "Sign in", new_session_path, class: "text-sm text-gray-600 hover:text-gray-900" %>
          <% end %>
        </div>
      </div>
    </nav>

    <%# Flash messages %>
    <% if notice %>
      <div class="fixed top-4 left-1/2 -translate-x-1/2 z-50 bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded shadow-lg" role="alert">
        <%= notice %>
      </div>
    <% end %>
    <% if alert %>
      <div class="fixed top-4 left-1/2 -translate-x-1/2 z-50 bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded shadow-lg" role="alert">
        <%= alert %>
      </div>
    <% end %>

    <%# Main content %>
    <main class="md:mt-20 mx-auto px-4 py-4">
      <%= yield %>
    </main>

    <%# Mobile bottom tab bar %>
    <% if authenticated? %>
      <nav class="md:hidden fixed bottom-0 w-full bg-white border-t border-gray-200 z-50" style="padding-bottom: env(safe-area-inset-bottom, 0px)">
        <div class="flex items-center justify-around h-16">
          <%= link_to feed_index_path, class: "flex flex-col items-center gap-0.5 px-3 py-1 #{current_page?(feed_index_path) ? 'text-blue-600' : 'text-gray-500'}" do %>
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
            <span class="text-xs">Home</span>
          <% end %>
          <% unless Current.user.admin? %>
            <%= link_to subjects_path, class: "flex flex-col items-center gap-0.5 px-3 py-1 #{current_page?(subjects_path) ? 'text-blue-600' : 'text-gray-500'}" do %>
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
              <span class="text-xs">Subjects</span>
            <% end %>
          <% end %>
          <%= link_to chat_rooms_path, class: "flex flex-col items-center gap-0.5 px-3 py-1 #{current_page?(chat_rooms_path) ? 'text-blue-600' : 'text-gray-500'}" do %>
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
            <span class="text-xs">Chats</span>
          <% end %>
          <% if Current.user.admin? %>
            <%= link_to admin_path, class: "flex flex-col items-center gap-0.5 px-3 py-1 #{current_page?(controller: 'admin/dashboard') ? 'text-blue-600' : 'text-gray-500'}" do %>
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
              <span class="text-xs">Admin</span>
            <% end %>
          <% end %>
          <%= link_to profile_path, class: "flex flex-col items-center gap-0.5 px-3 py-1 #{current_page?(profile_path) ? 'text-blue-600' : 'text-gray-500'}" do %>
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
            <span class="text-xs">Profile</span>
          <% end %>
        </div>
      </nav>
    <% end %>

    <%# Global Media Lightbox Modal %>
    <div id="lightbox-modal" class="fixed inset-0 bg-black/90 z-[100] items-center justify-center p-4 cursor-zoom-out" style="display: none;" onclick="closeLightbox(event)">
      <div class="relative w-full h-full max-w-5xl max-h-[90vh] flex items-center justify-center pointer-events-none" onclick="event.stopPropagation()">
        <!-- Close button -->
        <button class="absolute -top-10 right-0 md:top-2 md:-right-10 text-white text-4xl font-light hover:text-gray-300 cursor-pointer pointer-events-auto transition-colors" onclick="closeLightbox(event)">&times;</button>
        
        <!-- Image Container -->
        <img id="lightbox-img" src="" class="hidden max-w-full max-h-[85vh] object-contain rounded shadow-2xl scale-95 opacity-0 transition-all duration-300 pointer-events-auto" style="display: none;">
        
        <!-- PDF Container -->
        <iframe id="lightbox-pdf" src="" class="hidden w-full h-[85vh] rounded shadow-2xl opacity-0 scale-95 transition-all duration-300 pointer-events-auto bg-white" style="display: none;"></iframe>
        
        <!-- Video Container -->
        <video id="lightbox-video" src="" controls class="hidden max-w-full max-h-[85vh] rounded shadow-2xl opacity-0 scale-95 transition-all duration-300 pointer-events-auto" style="display: none;"></video>
        
        <!-- Audio Container -->
        <div id="lightbox-audio-container" class="hidden w-full max-w-md bg-white rounded-lg p-6 shadow-2xl opacity-0 scale-95 transition-all duration-300 pointer-events-auto flex flex-col items-center gap-4" style="display: none;">
          <svg class="w-16 h-16 text-blue-600 animate-pulse" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3"></path>
          </svg>
          <div class="text-sm font-medium text-gray-800 text-center truncate w-full" id="lightbox-audio-title">Audio Player</div>
          <audio id="lightbox-audio" src="" controls class="w-full"></audio>
        </div>
      </div>
    </div>

    <script>
      function showLightbox(src, type, title = '') {
        const modal = document.getElementById('lightbox-modal');
        const img = document.getElementById('lightbox-img');
        const pdf = document.getElementById('lightbox-pdf');
        const video = document.getElementById('lightbox-video');
        const audioContainer = document.getElementById('lightbox-audio-container');
        const audio = document.getElementById('lightbox-audio');
        const audioTitle = document.getElementById('lightbox-audio-title');
        
        if (!modal) return;
        
        // Hide all containers and reset src
        [img, pdf, video].forEach(el => {
          if (el) {
            el.style.display = 'none';
            el.src = '';
            el.classList.add('scale-95', 'opacity-0');
            el.classList.remove('scale-100', 'opacity-100');
          }
        });
        if (audioContainer && audio) {
          audioContainer.style.display = 'none';
          audio.src = '';
          audioContainer.classList.add('scale-95', 'opacity-0');
          audioContainer.classList.remove('scale-100', 'opacity-100');
        }
        
        let targetEl = null;
        
        if (type === 'image') {
          img.src = src;
          img.style.display = 'block';
          targetEl = img;
        } else if (type === 'pdf') {
          pdf.src = src;
          pdf.style.display = 'block';
          targetEl = pdf;
        } else if (type === 'video') {
          video.src = src;
          video.style.display = 'block';
          targetEl = video;
        } else if (type === 'audio') {
          audio.src = src;
          audioTitle.textContent = title || 'Audio Player';
          audioContainer.style.display = 'flex';
          targetEl = audioContainer;
        }
        
        if (!targetEl) return;
        
        modal.style.display = 'flex';
        setTimeout(() => {
          targetEl.classList.remove('scale-95', 'opacity-0');
          targetEl.classList.add('scale-100', 'opacity-100');
        }, 10);
      }

      function closeLightbox(event) {
        if (event && event.stopPropagation) {
          const modal = document.getElementById('lightbox-modal');
          if (event.target !== modal && !event.target.closest('button')) {
            return;
          }
        }

        const modal = document.getElementById('lightbox-modal');
        const img = document.getElementById('lightbox-img');
        const pdf = document.getElementById('lightbox-pdf');
        const video = document.getElementById('lightbox-video');
        const audioContainer = document.getElementById('lightbox-audio-container');
        const audio = document.getElementById('lightbox-audio');
        
        if (!modal) return;
        
        const activeEl = [img, pdf, video, audioContainer].find(el => el && el.style.display !== 'none');
        if (activeEl) {
          activeEl.classList.remove('scale-100', 'opacity-100');
          activeEl.classList.add('scale-95', 'opacity-0');
        }
        
        if (video) video.pause();
        if (audio) audio.pause();
        
        setTimeout(() => {
          modal.style.display = 'none';
          [img, pdf, video].forEach(el => { if (el) el.src = ''; });
          if (audio) audio.src = '';
        }, 300);
      }

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          closeLightbox();
        }
      });
    </script>
  </body>
</html>
