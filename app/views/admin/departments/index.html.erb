<div class="max-w-4xl mx-auto">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold"><%= t("admin.departments.index.title") %></h1>
    <%= link_to t("admin.departments.index.new"), new_admin_department_path, class: "rounded-md bg-blue-600 px-4 py-2 text-white text-sm font-medium hover:bg-blue-700" %>
  </div>

  <div class="bg-white rounded-lg shadow overflow-x-auto">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase"><%= t("admin.table.name") %></th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase"><%= t("admin.table.college") %></th>
          <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase"><%= t("common.actions") %></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-200">
        <% @departments.each do |dept| %>
          <tr>
            <td class="px-6 py-4"><%= dept.name %></td>
            <td class="px-6 py-4"><%= dept.college.name %></td>
            <td class="px-6 py-4 text-right space-x-2">
              <%= link_to t("admin.actions.show"), admin_department_path(dept), class: "text-blue-600 hover:text-blue-800 text-sm" %>
              <%= link_to t("common.edit"), edit_admin_department_path(dept), class: "text-blue-600 hover:text-blue-800 text-sm" %>
              <%= button_to t("common.delete"), admin_department_path(dept), method: :delete, class: "text-red-600 hover:text-red-800 text-sm", data: { turbo_confirm: t("common.confirm_delete") } %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
