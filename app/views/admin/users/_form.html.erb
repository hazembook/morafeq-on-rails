<%= form_with(model: [ :admin, user ]) do |f| %>
  <div class="mb-4">
    <%= f.label :full_name, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_field :full_name, class: "w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500" %>
    <% if user.errors[:full_name].any? %>
      <p class="text-red-500 text-xs mt-1"><%= user.errors[:full_name].join(", ") %></p>
    <% end %>
  </div>

  <div class="mb-4">
    <%= f.label :email_address, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.email_field :email_address, class: "w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500" %>
    <% if user.errors[:email_address].any? %>
      <p class="text-red-500 text-xs mt-1"><%= user.errors[:email_address].join(", ") %></p>
    <% end %>
  </div>

  <div class="mb-4">
    <%= f.label :password, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.password_field :password, class: "w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500" %>
    <p class="text-xs text-gray-500 mt-1">Leave blank to keep current password</p>
  </div>

  <div class="mb-4">
    <%= f.label :role, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.select :role, User.roles.keys.map { |r| [ r.titleize, r ] }, {}, class: "w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500" %>
  </div>

  <div class="mb-4">
    <%= f.label :bio, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_area :bio, rows: 3, class: "w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500" %>
  </div>

  <div class="flex gap-3">
    <%= f.submit class: "rounded-md bg-blue-600 px-4 py-2 text-white text-sm font-medium hover:bg-blue-700" %>
    <%= link_to "Cancel", admin_users_path, class: "rounded-md bg-gray-200 px-4 py-2 text-sm font-medium hover:bg-gray-300" %>
  </div>
<% end %>
