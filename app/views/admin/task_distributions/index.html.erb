<div class="max-w-6xl mx-auto">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold"><%= t("admin.task_distributions.index.title") %></h1>
    <%= link_to t("admin.task_distributions.index.new"), new_admin_task_distribution_path, class: "rounded-md bg-blue-600 px-4 py-2 text-white text-sm font-medium hover:bg-blue-700" %>
  </div>

  <div class="bg-white rounded-lg shadow overflow-x-auto">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-start text-xs font-medium text-gray-500 uppercase"><%= t("admin.task_distributions.index.assignee") %></th>
          <th class="px-6 py-3 text-start text-xs font-medium text-gray-500 uppercase"><%= t("admin.task_distributions.index.assigner") %></th>
          <th class="px-6 py-3 text-start text-xs font-medium text-gray-500 uppercase"><%= t("admin.task_distributions.index.scope") %></th>
          <th class="px-6 py-3 text-start text-xs font-medium text-gray-500 uppercase"><%= t("admin.task_distributions.index.flags") %></th>
          <th class="px-6 py-3 text-end text-xs font-medium text-gray-500 uppercase"><%= t("common.actions") %></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-200">
        <% @task_distributions.each do |td| %>
          <tr>
            <td class="px-6 py-4"><%= td.assignee.full_name %></td>
            <td class="px-6 py-4"><%= td.assigner.full_name %></td>
            <td class="px-6 py-4">
              <% if td.scope %>
                <%= td.scope_type %>: <%= td.scope.name %>
              <% else %>
                <span class="text-gray-400"><%= t("admin.task_distributions.index.global") %></span>
              <% end %>
            </td>
            <td class="px-6 py-4 text-sm">
              <% flags = TaskDistribution::FLAGS.select { |f| td.send(f) } %>
              <% if flags.any? %>
                <div class="flex flex-wrap gap-1">
                  <% flags.each do |flag| %>
                    <span class="inline-block bg-blue-100 text-blue-800 text-xs px-2 py-0.5 rounded"><%= t("admin.task_distributions.flags.#{flag}") %></span>
                  <% end %>
                </div>
              <% else %>
                <span class="text-gray-400"><%= t("admin.task_distributions.index.none") %></span>
              <% end %>
            </td>
            <td class="px-6 py-4 text-end rtl:space-x-reverse space-x-2 whitespace-nowrap">
              <%= link_to t("admin.actions.show"), admin_task_distribution_path(td), class: "text-blue-600 hover:text-blue-800 text-sm" %>
              <%= link_to t("common.edit"), edit_admin_task_distribution_path(td), class: "text-blue-600 hover:text-blue-800 text-sm" %>
              <%= button_to t("common.delete"), admin_task_distribution_path(td), method: :delete, class: "text-red-600 hover:text-red-800 text-sm", data: { turbo_confirm: t("common.confirm_delete") } %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
