<div class="max-w-lg mx-auto">
  <h1 class="text-2xl font-bold mb-6"><%= t("materials.new.upload_title") %></h1>

  <%= form_with model: [ @subject, @material ], local: true, class: "space-y-4" do |f| %>
    <div>
      <%= f.label :title, t("materials.new.title_label"), class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :title, class: "w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500" %>
      <% if @material.errors[:title].any? %>
        <p class="text-red-500 text-xs mt-1"><%= @material.errors[:title].join(", ") %></p>
      <% end %>
    </div>

    <div>
      <%= f.label :file, t("materials.new.file_label"), class: "block text-sm font-medium text-gray-700 mb-1" %>
      <div class="flex items-center gap-3">
        <%= f.file_field :file, accept: ".pdf,.ppt,.pptx,.doc,.docx,.png,.jpg,.jpeg,.gif,.webp", class: "hidden", id: "material-file-input", data: { selected_template: t("chats.files_selected", count: "%{count}"), placeholder: t("common.no_file_chosen") }, onchange: "let label = document.getElementById('material-file-label'); if(this.files.length > 0) { label.innerText = this.getAttribute('data-selected-template').replace('%{count}', this.files.length); } else { label.innerText = this.getAttribute('data-placeholder'); }" %>
        <label for="material-file-input" class="py-2 px-4 rounded-md border border-gray-300 text-sm font-medium bg-white text-gray-700 hover:bg-gray-50 cursor-pointer shadow-sm">
          <%= t("common.choose_file") %>
        </label>
        <span id="material-file-label" data-placeholder="<%= t("common.no_file_chosen") %>" class="text-xs text-gray-500"><%= t("common.no_file_chosen") %></span>
      </div>
      <p class="text-xs text-gray-400 mt-1.5"><%= t("materials.new.allowed_types") %></p>
      <% if @material.errors[:file].any? %>
        <p class="text-red-500 text-xs mt-1"><%= @material.errors[:file].join(", ") %></p>
      <% end %>
    </div>

    <div class="flex gap-3">
      <%= f.submit t("materials.new.upload_button"), class: "rounded-md bg-blue-600 px-4 py-2 text-white text-sm font-medium hover:bg-blue-700 cursor-pointer" %>
      <%= link_to t("common.cancel"), subject_materials_path(@subject), class: "rounded-md bg-gray-200 px-4 py-2 text-sm font-medium hover:bg-gray-300" %>
    </div>
  <% end %>
</div>
