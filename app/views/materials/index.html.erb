<div class="max-w-3xl mx-auto">
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-6">
    <div>
      <h1 class="text-2xl font-bold"><%= @subject.name %></h1>
      <p class="text-gray-500">Materials</p>
    </div>
    <% if Current.user.admin? || @subject.teacher == Current.user %>
      <%= link_to "Upload Material", new_subject_material_path(@subject), class: "rounded-md bg-blue-600 px-4 py-2 text-white text-sm font-medium hover:bg-blue-700 text-center" %>
    <% end %>
  </div>

  <% if @materials.any? %>
    <div class="space-y-3">
      <% @materials.each do |material| %>
        <% if material.file.attached? %>
          <% file = material.file %>
          <% if file.image? %>
            <% preview_type = "image" %>
          <% elsif file.video? %>
            <% preview_type = "video" %>
          <% elsif file.audio? %>
            <% preview_type = "audio" %>
          <% elsif file.content_type == "application/pdf" %>
            <% preview_type = "pdf" %>
          <% else %>
            <% preview_type = nil %>
          <% end %>
        <% else %>
          <% preview_type = nil %>
        <% end %>

        <div class="bg-white rounded-lg shadow p-4 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 group">
          <div class="flex items-center gap-3 min-w-0 flex-1">
            <!-- Dynamic File Icon -->
            <div class="p-2 bg-gray-50 rounded-md border border-gray-100 text-gray-500 group-hover:text-blue-600 transition-colors shrink-0">
              <% if preview_type == "pdf" %>
                <svg class="w-8 h-8 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 9h1.5M9 13h6m-6 4h6"></path>
                </svg>
              <% elsif preview_type == "video" %>
                <svg class="w-8 h-8 text-purple-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
                </svg>
              <% elsif preview_type == "audio" %>
                <svg class="w-8 h-8 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3"></path>
                </svg>
              <% elsif preview_type == "image" %>
                <svg class="w-8 h-8 text-orange-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                </svg>
              <% else %>
                <svg class="w-8 h-8 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                </svg>
              <% end %>
            </div>
            
            <div class="min-w-0 flex-1">
              <% if preview_type.present? %>
                <button class="text-left font-medium block w-full truncate hover:text-blue-600 cursor-pointer font-sans" onclick="showLightbox('<%= rails_blob_path(material.file, only_path: true) %>', '<%= preview_type %>', '<%= j material.title %>')">
                  <%= material.title %>
                </button>
              <% else %>
                <%= link_to material.title, subject_material_path(@subject, material, download: true), class: "font-medium block truncate hover:text-blue-600", data: { turbo: false } %>
              <% end %>
              <div class="flex items-center gap-2 mt-0.5">
                <span class="text-xs text-gray-400"><%= time_ago_in_words(material.created_at) %> ago</span>
                <% if material.file.attached? %>
                  <span class="text-xs text-gray-300">&middot;</span>
                  <span class="text-xs text-gray-400"><%= number_to_human_size(material.file.byte_size) %></span>
                <% end %>
              </div>
            </div>
          </div>
          <div class="flex items-center gap-2 self-end sm:self-auto shrink-0">
            <% if preview_type.present? %>
              <button class="rounded-md bg-blue-50 px-3 py-1.5 text-blue-700 text-sm font-medium hover:bg-blue-100 border border-blue-200 transition-colors cursor-pointer font-sans" onclick="showLightbox('<%= rails_blob_path(material.file, only_path: true) %>', '<%= preview_type %>', '<%= j material.title %>')">
                Preview
              </button>
            <% end %>
            <%= link_to "Download", subject_material_path(@subject, material, download: true), class: "rounded-md bg-blue-600 px-3 py-1.5 text-white text-sm hover:bg-blue-700 whitespace-nowrap transition-colors", data: { turbo: false } %>
            <% if Current.user.admin? || @subject.teacher == Current.user %>
              <%= button_to "Delete", subject_material_path(@subject, material), method: :delete, class: "rounded-md border border-gray-200 bg-white text-red-600 text-sm hover:text-red-800 hover:bg-gray-50 px-3 py-1.5 whitespace-nowrap transition-colors", data: { turbo_confirm: "Are you sure?" } %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="bg-white rounded-lg shadow p-8 text-center">
      <p class="text-gray-500">No materials uploaded yet.</p>
    </div>
  <% end %>
</div>
