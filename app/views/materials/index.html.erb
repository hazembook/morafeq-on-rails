<div class="max-w-3xl mx-auto">
  <div class="flex items-center justify-between mb-6">
    <div>
      <h1 class="text-2xl font-bold"><%= @subject.name %></h1>
      <p class="text-gray-500">Materials</p>
    </div>
    <% if Current.user.admin? || @subject.teacher == Current.user %>
      <%= link_to "Upload Material", new_subject_material_path(@subject), class: "rounded-md bg-blue-600 px-4 py-2 text-white text-sm font-medium hover:bg-blue-700" %>
    <% end %>
  </div>

  <% if @materials.any? %>
    <div class="space-y-3">
      <% @materials.each do |material| %>
        <div class="bg-white rounded-lg shadow p-4 flex items-center justify-between">
          <div class="flex items-center gap-3">
            <svg class="w-8 h-8 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
            </svg>
            <div>
              <p class="font-medium"><%= material.title %></p>
              <p class="text-xs text-gray-400"><%= time_ago_in_words(material.created_at) %> ago</p>
            </div>
          </div>
          <div class="flex gap-2">
            <%= link_to "Download", subject_material_path(@subject, material), class: "rounded-md bg-blue-600 px-3 py-1.5 text-white text-sm hover:bg-blue-700" %>
            <% if Current.user.admin? || @subject.teacher == Current.user %>
              <%= button_to "Delete", subject_material_path(@subject, material), method: :delete, class: "text-red-600 text-sm hover:text-red-800", data: { turbo_confirm: "Are you sure?" } %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="bg-white rounded-lg shadow p-8 text-center">
      <p class="text-gray-500">No materials uploaded yet.</p>
    </div>
  <% end %>
</div>
