<div class="max-w-4xl mx-auto px-4 py-6">
  <div class="mb-6">
    <%= link_to "← Back to Attendance", subject_attendances_path(@subject), class: "text-sm text-blue-600 hover:text-blue-800" %>
    <h1 class="text-2xl font-bold mt-2 text-gray-900">Record Attendance</h1>
    <p class="text-sm text-gray-500"><%= @subject.name %> (<%= @subject.code %>)</p>
  </div>

  <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-6 mb-6">
    <%= form_with url: record_subject_attendances_path(@subject), method: :get, class: "flex flex-col sm:flex-row sm:items-center gap-3" do |f| %>
      <%= f.label :date, "Attendance Date:", class: "text-sm font-semibold text-gray-700" %>
      <%= f.date_field :date, value: @date, onchange: "this.form.requestSubmit();", class: "rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm py-1.5" %>
      <span class="text-xs text-gray-400">Selecting a date will load existing records.</span>
    <% end %>
  </div>

  <% if @students.any? %>
    <%= form_with url: subject_attendances_path(@subject), method: :post, class: "space-y-6" do |f| %>
      <%= hidden_field_tag :date, @date %>
      
      <div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wide">Student</th>
              <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wide">Status</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-150 bg-white">
            <% @students.each do |student| %>
              <% existing_att = @existing_attendances[student.id] %>
              <% selected_status = existing_att&.status || "present" %>
              <tr class="hover:bg-gray-50 transition-colors">
                <td class="px-6 py-4 text-sm font-semibold text-gray-900"><%= student.full_name %></td>
                <td class="px-6 py-4 text-sm">
                  <div class="flex items-center gap-4">
                    <label class="flex items-center gap-1.5 cursor-pointer">
                      <%= radio_button_tag "attendance[#{student.id}]", "present", selected_status == "present", class: "text-blue-600 focus:ring-blue-500 focus:ring-2 border-gray-300" %>
                      <span class="text-sm text-gray-700">Present</span>
                    </label>
                    <label class="flex items-center gap-1.5 cursor-pointer">
                      <%= radio_button_tag "attendance[#{student.id}]", "absent", selected_status == "absent", class: "text-red-600 focus:ring-red-500 focus:ring-2 border-gray-300" %>
                      <span class="text-sm text-gray-700">Absent</span>
                    </label>
                    <label class="flex items-center gap-1.5 cursor-pointer">
                      <%= radio_button_tag "attendance[#{student.id}]", "excused", selected_status == "excused", class: "text-yellow-600 focus:ring-yellow-500 focus:ring-2 border-gray-300" %>
                      <span class="text-sm text-gray-700">Excused</span>
                    </label>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <div class="flex justify-end gap-3">
        <%= link_to "Cancel", subject_attendances_path(@subject), class: "px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50" %>
        <%= f.submit "Save Attendance", class: "px-6 py-2 text-sm font-semibold text-white bg-blue-600 rounded-lg hover:bg-blue-700 shadow-sm cursor-pointer" %>
      </div>
    <% end %>
  <% else %>
    <div class="bg-white rounded-xl border border-gray-200 p-12 text-center shadow-sm">
      <p class="text-gray-500">No students enrolled in this subject.</p>
    </div>
  <% end %>
</div>
