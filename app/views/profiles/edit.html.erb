<div class="max-w-md mx-auto">
  <h1 class="text-xl font-bold mb-6">Edit Profile</h1>

  <%= form_with model: @user, url: profile_path, local: true, class: "space-y-4" do |f| %>
    <div>
      <%= f.label :full_name, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :full_name, class: "w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500" %>
    </div>

    <div>
      <%= f.label :bio, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_area :bio, rows: 3, class: "w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500" %>
    </div>

    <div>
      <%= f.label :avatar, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.file_field :avatar, class: "w-full text-sm" %>
    </div>

    <div class="flex gap-3">
      <%= f.submit "Save", class: "rounded-md bg-blue-600 px-4 py-2 text-white text-sm font-medium hover:bg-blue-700" %>
      <%= link_to "Cancel", profile_path, class: "rounded-md bg-gray-200 px-4 py-2 text-sm font-medium hover:bg-gray-300" %>
    </div>
  <% end %>
</div>
