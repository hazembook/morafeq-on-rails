<div class="max-w-md mx-auto">
  <div class="bg-white rounded-lg shadow p-6 text-center mb-4">
    <% if @user.avatar.attached? %>
      <%= image_tag @user.avatar, class: "w-20 h-20 rounded-full mx-auto mb-3 object-cover" %>
    <% else %>
      <div class="w-20 h-20 rounded-full bg-blue-100 mx-auto mb-3 flex items-center justify-center">
        <span class="text-2xl font-bold text-blue-600"><%= @user.full_name.first %></span>
      </div>
    <% end %>
    <h1 class="text-xl font-bold"><%= @user.full_name %></h1>
    <p class="text-gray-500 text-sm"><%= @user.email_address %></p>
    <span class="inline-block mt-2 text-xs bg-blue-100 text-blue-700 px-2 py-1 rounded"><%= @user.role.titleize %></span>
    <% if @user.bio.present? %>
      <p class="text-gray-600 text-sm mt-3"><%= @user.bio %></p>
    <% end %>
  </div>

  <% unless @user.student? %>
    <div class="bg-white rounded-lg shadow p-6 mb-4">
      <h2 class="font-semibold mb-2">Teaching</h2>
      <p class="text-sm text-gray-500"><%= @user.taught_subjects.count %> subjects</p>
    </div>
  <% end %>

  <div class="bg-white rounded-lg shadow p-6 mb-4">
    <h2 class="font-semibold mb-2">Enrolled Subjects</h2>
    <p class="text-sm text-gray-500"><%= @user.subjects.count %> subjects</p>
  </div>

  <div class="space-y-2">
    <%= link_to "Edit Profile", edit_profile_path, class: "block text-center rounded-md bg-blue-600 px-4 py-2 text-white text-sm font-medium hover:bg-blue-700" %>
    <% if @user.admin? %>
      <%= link_to "Admin Panel", admin_path, class: "block text-center rounded-md bg-gray-200 px-4 py-2 text-sm font-medium hover:bg-gray-300" %>
    <% end %>
    <%= button_to "Sign out", session_path, method: :delete, class: "w-full text-center rounded-md bg-red-100 px-4 py-2 text-red-700 text-sm font-medium hover:bg-red-200" %>
  </div>
</div>
