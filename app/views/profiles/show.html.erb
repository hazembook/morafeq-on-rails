<div class="max-w-5xl mx-auto px-4 py-8">
  <!-- Profile Header Card with Premium Gradient and Glassmorphic Elements -->
  <div class="relative overflow-hidden rounded-3xl bg-gradient-to-tr from-slate-900 via-indigo-950 to-slate-900 shadow-2xl mb-8 border border-white/10 p-6 sm:p-8">
    <!-- Decorative background glow blobs -->
    <div class="absolute -end-16 -top-16 w-64 h-64 rounded-full bg-indigo-500/20 blur-3xl pointer-events-none"></div>
    <div class="absolute -start-16 -bottom-16 w-64 h-64 rounded-full bg-purple-500/10 blur-3xl pointer-events-none"></div>

    <div class="relative z-10 flex flex-col md:flex-row items-center gap-6 text-center md:text-start">
      <!-- Avatar Section with Glow Effect -->
      <div class="relative shrink-0">
        <div class="absolute -inset-1.5 rounded-full bg-gradient-to-r from-blue-500 via-purple-500 to-indigo-500 opacity-75 blur-md"></div>
        <% if @user.avatar.attached? %>
          <%= image_tag @user.avatar, class: "relative w-28 h-28 rounded-full border-4 border-slate-900 object-cover shadow-2xl" %>
        <% else %>
          <div class="relative w-28 h-28 rounded-full bg-slate-800 border-4 border-slate-900 flex items-center justify-center shadow-2xl">
            <span class="text-4xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-indigo-300">
              <%= @user.full_name.first %>
            </span>
          </div>
        <% end %>
      </div>

      <!-- Info Section -->
      <div class="flex-1 space-y-2">
        <div class="flex flex-col sm:flex-row sm:items-center justify-center md:justify-start gap-2.5">
          <h1 class="text-3xl font-extrabold text-white tracking-tight"><%= @user.full_name %></h1>
          <div>
            <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-white/10 text-indigo-300 border border-indigo-500/30">
              <%= t("roles.#{@user.role}") %>
            </span>
          </div>
        </div>
        <p class="text-slate-300 font-medium text-sm sm:text-base"><%= @user.email_address %></p>
        
        <% if @user.bio.present? %>
          <p class="text-slate-400 text-sm max-w-2xl leading-relaxed italic border-t border-white/5 pt-2 mt-2">
            "<%= @user.bio %>"
          </p>
        <% else %>
          <p class="text-slate-500 text-xs mt-2 italic"><%= t("profile.no_bio") %></p>
        <% end %>
      </div>

      <!-- Quick Action Buttons -->
      <div class="shrink-0 flex flex-col sm:flex-row md:flex-col gap-2.5 w-full md:w-auto mt-4 md:mt-0">
        <%= link_to edit_profile_path, class: "flex items-center justify-center gap-2 rounded-xl bg-white/10 px-5 py-2.5 text-sm font-semibold text-white hover:bg-white/15 border border-white/10 transition-all cursor-pointer shadow-sm" do %>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path>
          </svg>
          <%= t("profile.edit") %>
        <% end %>
        
        <%# Language Switcher %>
        <% if I18n.locale == :ar %>
          <%= link_to url_for(locale: :en), class: "flex items-center justify-center gap-2 rounded-xl bg-white/10 px-5 py-2.5 text-sm font-semibold text-white hover:bg-white/15 border border-white/10 transition-all cursor-pointer shadow-sm" do %>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 002 2h2a2.5 2.5 0 002.5-2.5V10a2 2 0 00-2-2h-1a2 2 0 00-2-2v-1a2 2 0 00-2-2H9.83C8.69 2 7.55 2.68 7 3.78"></path>
            </svg>
            English
          <% end %>
        <% else %>
          <%= link_to url_for(locale: :ar), class: "flex items-center justify-center gap-2 rounded-xl bg-white/10 px-5 py-2.5 text-sm font-semibold text-white hover:bg-white/15 border border-white/10 transition-all cursor-pointer shadow-sm" do %>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 002 2h2a2.5 2.5 0 002.5-2.5V10a2 2 0 00-2-2h-1a2 2 0 00-2-2v-1a2 2 0 00-2-2H9.83C8.69 2 7.55 2.68 7 3.78"></path>
            </svg>
            العربية (Arabic)
          <% end %>
        <% end %>

        <% if @user.admin? %>
          <%= link_to admin_path, class: "flex items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-blue-600 to-indigo-600 px-5 py-2.5 text-sm font-semibold text-white hover:from-blue-700 hover:to-indigo-700 transition cursor-pointer shadow-md" do %>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
            </svg>
            <%= t("nav.admin") %>
          <% end %>
        <% end %>
        
        <%= button_to session_path, method: :delete, class: "flex items-center justify-center gap-2 w-full rounded-xl bg-red-950/40 text-red-300 hover:bg-red-950/60 border border-red-900/30 px-5 py-2.5 text-sm font-semibold transition cursor-pointer" do %>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
          </svg>
          <%= t("profile.sign_out") %>
        <% end %>
      </div>
    </div>
  </div>

  <% if @user.student? %>
    <!-- STUDENT ACADEMIC ANALYSIS DASHBOARD -->
    
    <!-- KPI Summary Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 mb-8">
      <!-- Attendance Card -->
      <div class="bg-white rounded-2xl border border-gray-200 p-6 shadow-sm hover:shadow-md transition-all duration-300 hover:-translate-y-0.5">
        <div class="flex items-center justify-between mb-4">
          <span class="text-sm font-bold text-gray-500 uppercase tracking-wide">Class Attendance</span>
          <div class="p-2 rounded-xl bg-indigo-50 text-indigo-600">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
            </svg>
          </div>
        </div>
        <div class="flex items-baseline gap-1.5">
          <span class="text-3xl font-extrabold text-slate-900">
            <%= @attendance_rate.present? ? "#{@attendance_rate}%" : "N/A" %>
          </span>
          <% if @attendance_rate.present? %>
            <span class="text-xs font-semibold text-gray-400">rate</span>
          <% end %>
        </div>
        
        <div class="mt-4">
          <div class="h-2 w-full bg-gray-100 rounded-full overflow-hidden">
            <div class="h-full bg-indigo-600 rounded-full transition-all duration-500" style="width: <%= @attendance_rate || 0 %>%"></div>
          </div>
          <div class="flex justify-between text-xxs text-gray-500 mt-2 font-medium">
            <span><%= @present_attendances %> Present</span>
            <span><%= @excused_attendances %> Excused</span>
            <span><%= @absent_attendances %> Absent</span>
          </div>
        </div>
      </div>

      <!-- Quiz Average Card -->
      <div class="bg-white rounded-2xl border border-gray-200 p-6 shadow-sm hover:shadow-md transition-all duration-300 hover:-translate-y-0.5">
        <div class="flex items-center justify-between mb-4">
          <span class="text-sm font-bold text-gray-500 uppercase tracking-wide">Quiz Average</span>
          <div class="p-2 rounded-xl bg-emerald-50 text-emerald-600">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"></path>
            </svg>
          </div>
        </div>
        <div class="flex items-baseline gap-1.5">
          <span class="text-3xl font-extrabold text-slate-900">
            <%= @quiz_average.present? ? "#{@quiz_average}%" : "N/A" %>
          </span>
          <% if @quiz_average.present? %>
            <span class="text-xs font-semibold text-gray-400">average</span>
          <% end %>
        </div>
        
        <div class="mt-4">
          <div class="h-2 w-full bg-gray-100 rounded-full overflow-hidden">
            <div class="h-full bg-emerald-500 rounded-full transition-all duration-500" style="width: <%= @quiz_average || 0 %>%"></div>
          </div>
          <div class="flex justify-between text-xxs text-gray-500 mt-2 font-medium">
            <span>Completed <%= @quizzes_completed %> of <%= @total_quizzes %> quizzes</span>
          </div>
        </div>
      </div>

      <!-- Assignment Average Card -->
      <div class="bg-white rounded-2xl border border-gray-200 p-6 shadow-sm hover:shadow-md transition-all duration-300 hover:-translate-y-0.5">
        <div class="flex items-center justify-between mb-4">
          <span class="text-sm font-bold text-gray-500 uppercase tracking-wide">Assignment Grade</span>
          <div class="p-2 rounded-xl bg-purple-50 text-purple-600">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
            </svg>
          </div>
        </div>
        <div class="flex items-baseline gap-1.5">
          <span class="text-3xl font-extrabold text-slate-900">
            <%= @assignment_average.present? ? "#{@assignment_average}%" : "N/A" %>
          </span>
          <% if @assignment_average.present? %>
            <span class="text-xs font-semibold text-gray-400">average</span>
          <% end %>
        </div>
        
        <div class="mt-4">
          <div class="h-2 w-full bg-gray-100 rounded-full overflow-hidden">
            <div class="h-full bg-purple-500 rounded-full transition-all duration-500" style="width: <%= @assignment_average || 0 %>%"></div>
          </div>
          <div class="flex justify-between text-xxs text-gray-500 mt-2 font-medium">
            <span>Submitted <%= @assignments_completed %> of <%= @total_assignments %> files</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Subject Analysis Breakdown List -->
    <div class="bg-white rounded-3xl border border-gray-200 p-6 shadow-sm mb-8">
      <h2 class="text-xl font-bold text-slate-900 mb-6 flex items-center gap-2.5">
        <svg class="w-5 h-5 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 8v8m-4-5v5m-4-2v2m-2 4h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
        </svg>
        Subject Performance Analytics
      </h2>

      <% if @subject_stats.any? %>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <% @subject_stats.each do |stat| %>
            <% subject = stat[:subject] %>
            <div class="rounded-2xl border border-gray-100 bg-slate-50/50 p-5 space-y-4 hover:border-gray-300 transition-all">
              <div>
                <h3 class="font-bold text-base text-slate-800"><%= subject.name %></h3>
                <p class="text-xs text-gray-400 font-bold uppercase tracking-wider mt-0.5"><%= subject.code %> &middot; Professor <%= subject.teacher.full_name %></p>
              </div>

              <div class="space-y-3.5 pt-2">
                <!-- Attendance Breakdown -->
                <div class="space-y-1">
                  <div class="flex justify-between items-center text-xs font-semibold">
                    <span class="text-gray-500">Attendance Rate</span>
                    <span class="<%= stat[:attendance_rate].to_f >= 75 ? 'text-indigo-600' : 'text-orange-600' %>">
                      <%= stat[:attendance_rate].present? ? "#{stat[:attendance_rate]}%" : "No records" %>
                    </span>
                  </div>
                  <div class="h-2 w-full bg-gray-200/60 rounded-full overflow-hidden">
                    <div class="h-full bg-indigo-500 rounded-full" style="width: <%= stat[:attendance_rate] || 0 %>%"></div>
                  </div>
                </div>

                <!-- Quiz Performance Breakdown -->
                <div class="space-y-1">
                  <div class="flex justify-between items-center text-xs font-semibold">
                    <span class="text-gray-500">Quiz average</span>
                    <span class="text-emerald-600">
                      <%= stat[:quiz_average].present? ? "#{stat[:quiz_average]}%" : "No graded quizzes" %>
                    </span>
                  </div>
                  <div class="h-2 w-full bg-gray-200/60 rounded-full overflow-hidden">
                    <div class="h-full bg-emerald-500 rounded-full" style="width: <%= stat[:quiz_average] || 0 %>%"></div>
                  </div>
                </div>

                <!-- Assignment Performance Breakdown -->
                <div class="space-y-1">
                  <div class="flex justify-between items-center text-xs font-semibold">
                    <span class="text-gray-500">Assignment average</span>
                    <span class="text-purple-600">
                      <%= stat[:assignment_average].present? ? "#{stat[:assignment_average]}%" : "No graded assignments" %>
                    </span>
                  </div>
                  <div class="h-2 w-full bg-gray-200/60 rounded-full overflow-hidden">
                    <div class="h-full bg-purple-500 rounded-full" style="width: <%= stat[:assignment_average] || 0 %>%"></div>
                  </div>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="text-center py-8">
          <p class="text-sm text-gray-500 italic">You are not enrolled in any subjects yet.</p>
        </div>
      <% end %>
    </div>

  <% elsif @user.teacher? %>
    <!-- TEACHER COURSE PERFORMANCE ANALYTICS -->
    
    <!-- KPI Summary Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 mb-8">
      <!-- Total Students Taught -->
      <div class="bg-white rounded-2xl border border-gray-200 p-6 shadow-sm">
        <div class="flex items-center justify-between mb-3">
          <span class="text-sm font-bold text-gray-500 uppercase tracking-wide">Students Taught</span>
          <div class="p-2 rounded-xl bg-blue-50 text-blue-600">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path>
            </svg>
          </div>
        </div>
        <span class="text-3xl font-extrabold text-slate-900"><%= @total_students %></span>
        <p class="text-xs text-gray-500 mt-1 font-medium">Enrolled across your classes</p>
      </div>

      <!-- Subjects Taught -->
      <div class="bg-white rounded-2xl border border-gray-200 p-6 shadow-sm">
        <div class="flex items-center justify-between mb-3">
          <span class="text-sm font-bold text-gray-500 uppercase tracking-wide">Courses Teaching</span>
          <div class="p-2 rounded-xl bg-indigo-50 text-indigo-600">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
            </svg>
          </div>
        </div>
        <span class="text-3xl font-extrabold text-slate-900"><%= @user.taught_subjects.count %></span>
        <p class="text-xs text-gray-500 mt-1 font-medium">Active subject materials & chat</p>
      </div>

      <!-- Authored Posts -->
      <div class="bg-white rounded-2xl border border-gray-200 p-6 shadow-sm">
        <div class="flex items-center justify-between mb-3">
          <span class="text-sm font-bold text-gray-500 uppercase tracking-wide">Authored Announcements</span>
          <div class="p-2 rounded-xl bg-purple-50 text-purple-600">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z"></path>
            </svg>
          </div>
        </div>
        <span class="text-3xl font-extrabold text-slate-900"><%= @total_posts %></span>
        <p class="text-xs text-gray-500 mt-1 font-medium">Broadcasts to student feeds</p>
      </div>
    </div>

    <!-- Taught Subject Class Performance Breakdown -->
    <div class="bg-white rounded-3xl border border-gray-200 p-6 shadow-sm mb-8">
      <h2 class="text-xl font-bold text-slate-900 mb-6 flex items-center gap-2.5">
        <svg class="w-5 h-5 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
            </svg>
        Course Performance & Grading Analytics
      </h2>

      <% if @taught_subject_stats.any? %>
        <div class="space-y-6">
          <% @taught_subject_stats.each do |stat| %>
            <% subject = stat[:subject] %>
            <div class="rounded-2xl border border-gray-100 p-5 bg-slate-50/50 hover:bg-slate-50 transition-colors">
              <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-4 pb-2 border-b border-gray-200/60">
                <div>
                  <h3 class="font-bold text-lg text-slate-800"><%= subject.name %></h3>
                  <p class="text-xs font-bold text-indigo-600 mt-0.5 uppercase tracking-wide"><%= subject.code %> &middot; Department of <%= subject.department.name %></p>
                </div>
                <span class="px-3.5 py-1 rounded-full text-xs font-semibold bg-indigo-50 border border-indigo-100 text-indigo-700">
                  <%= stat[:student_count] %> Enrolled Students
                </span>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
                <!-- Average Attendance -->
                <div class="space-y-1">
                  <span class="text-xs font-bold text-gray-400 uppercase tracking-wide">Avg Student Attendance</span>
                  <div class="flex items-baseline gap-1.5 mt-1">
                    <span class="text-xl font-extrabold text-slate-800">
                      <%= stat[:attendance_rate].present? ? "#{stat[:attendance_rate]}%" : "No data" %>
                    </span>
                  </div>
                  <div class="h-1.5 w-full bg-gray-200 rounded-full overflow-hidden mt-1">
                    <div class="h-full bg-indigo-600 rounded-full" style="width: <%= stat[:attendance_rate] || 0 %>%"></div>
                  </div>
                </div>

                <!-- Average Quiz Grades -->
                <div class="space-y-1">
                  <span class="text-xs font-bold text-gray-400 uppercase tracking-wide">Class Quiz average</span>
                  <div class="flex items-baseline gap-1.5 mt-1">
                    <span class="text-xl font-extrabold text-slate-800">
                      <%= stat[:quiz_average].present? ? "#{stat[:quiz_average]}%" : "No quizzes" %>
                    </span>
                  </div>
                  <div class="h-1.5 w-full bg-gray-200 rounded-full overflow-hidden mt-1">
                    <div class="h-full bg-emerald-500 rounded-full" style="width: <%= stat[:quiz_average] || 0 %>%"></div>
                  </div>
                </div>

                <!-- Average Assignment Grades -->
                <div class="space-y-1">
                  <span class="text-xs font-bold text-gray-400 uppercase tracking-wide">Class Assignment average</span>
                  <div class="flex items-baseline gap-1.5 mt-1">
                    <span class="text-xl font-extrabold text-slate-800">
                      <%= stat[:assignment_average].present? ? "#{stat[:assignment_average]}%" : "No assignments" %>
                    </span>
                  </div>
                  <div class="h-1.5 w-full bg-gray-200 rounded-full overflow-hidden mt-1">
                    <div class="h-full bg-purple-500 rounded-full" style="width: <%= stat[:assignment_average] || 0 %>%"></div>
                  </div>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="text-center text-sm text-gray-500 italic py-6">You are not currently teaching any subjects.</p>
      <% end %>
    </div>

  <% elsif @user.admin? %>
    <!-- ADMIN SYSTEM OVERVIEW DASHBOARD -->
    
    <div class="bg-white rounded-3xl border border-gray-200 p-6 shadow-sm mb-8">
      <h2 class="text-xl font-bold text-slate-900 mb-6 flex items-center gap-2.5">
        <svg class="w-5 h-5 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 11c0 3.517-1.009 6.799-2.753 9.571m-3.44-2.04l.054-.09A13.916 13.916 0 009 14a13.92 13.92 0 00-6 11.218m10.584-4.62c.165-.277.306-.565.422-.864m3.198-3.198a5.96 5.96 0 00-.54-3.09M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
        </svg>
        System Management Diagnostics
      </h2>

      <!-- Admin System Grid -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-6">
        <div class="p-5 rounded-2xl bg-slate-50 border border-gray-100 flex flex-col justify-between">
          <span class="text-xs font-bold text-gray-400 uppercase tracking-wide">Colleges</span>
          <span class="text-3xl font-extrabold text-slate-800 mt-2"><%= @system_stats[:colleges] %></span>
        </div>
        <div class="p-5 rounded-2xl bg-slate-50 border border-gray-100 flex flex-col justify-between">
          <span class="text-xs font-bold text-gray-400 uppercase tracking-wide">Departments</span>
          <span class="text-3xl font-extrabold text-slate-800 mt-2"><%= @system_stats[:departments] %></span>
        </div>
        <div class="p-5 rounded-2xl bg-slate-50 border border-gray-100 flex flex-col justify-between">
          <span class="text-xs font-bold text-gray-400 uppercase tracking-wide">Subjects</span>
          <span class="text-3xl font-extrabold text-slate-800 mt-2"><%= @system_stats[:subjects] %></span>
        </div>
        <div class="p-5 rounded-2xl bg-slate-50 border border-gray-100 flex flex-col justify-between">
          <span class="text-xs font-bold text-gray-400 uppercase tracking-wide">Total Students</span>
          <span class="text-3xl font-extrabold text-slate-800 mt-2"><%= @system_stats[:students] %></span>
        </div>
        <div class="p-5 rounded-2xl bg-slate-50 border border-gray-100 flex flex-col justify-between">
          <span class="text-xs font-bold text-gray-400 uppercase tracking-wide">Total Teachers</span>
          <span class="text-3xl font-extrabold text-slate-800 mt-2"><%= @system_stats[:teachers] %></span>
        </div>
        <div class="p-5 rounded-2xl bg-slate-50 border border-gray-100 flex flex-col justify-between">
          <span class="text-xs font-bold text-gray-400 uppercase tracking-wide">Total Posts</span>
          <span class="text-3xl font-extrabold text-slate-800 mt-2"><%= @system_stats[:posts] %></span>
        </div>
        <div class="p-5 rounded-2xl bg-slate-50 border border-gray-100 flex flex-col justify-between col-span-2">
          <span class="text-xs font-bold text-gray-400 uppercase tracking-wide">Total Messages Sent</span>
          <span class="text-3xl font-extrabold text-slate-800 mt-2"><%= @system_stats[:messages] %></span>
        </div>
      </div>
    </div>
  <% end %>
</div>
