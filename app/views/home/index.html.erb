  <div class="flex flex-col items-center justify-center min-h-[60vh] text-center px-4">
    <h1 class="text-4xl font-bold text-gray-900 mb-4">Welcome to Morafeq</h1>
    <p class="text-lg text-gray-600 mb-8 max-w-md">Your university companion app. Stay connected with your courses, materials, and community.</p>
    <% if authenticated? %>
      <p class="text-gray-500">You're signed in as <strong><%= Current.user.full_name %></strong>.</p>
    <% else %>
      <div class="flex gap-4">
        <%= link_to "Sign in", new_session_path, class: "rounded-md bg-blue-600 px-6 py-3 text-white font-medium hover:bg-blue-700" %>
        <%= link_to "Sign up", new_session_path, class: "rounded-md bg-gray-200 px-6 py-3 text-gray-800 font-medium hover:bg-gray-300" %>
      </div>
    <% end %>
  </div>
