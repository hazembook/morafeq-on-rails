<div class="flex flex-col items-center justify-center min-h-[70vh] text-center px-4 max-w-lg mx-auto">
  <h1 class="text-4xl font-bold text-gray-900 mb-4"><%= t("home.welcome") %></h1>
  <p class="text-lg text-gray-600 mb-8"><%= t("home.subtitle") %></p>
  <% if authenticated? %>
    <p class="text-gray-500"><%= t("home.signed_in_as", name: Current.user.full_name) %></p>
  <% else %>
    <div class="flex gap-4">
      <%= link_to t("nav.sign_in"), new_session_path, class: "rounded-md bg-blue-600 px-6 py-3 text-white font-medium hover:bg-blue-700" %>
    </div>
  <% end %>
</div>
