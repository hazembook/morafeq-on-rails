<div class="max-w-4xl mx-auto">
  <div class="bg-white rounded-lg shadow p-6 mb-6">
    <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4">
      <div>
        <h1 class="text-2xl font-bold"><%= @subject.name %></h1>
        <p class="text-gray-500"><%= @subject.code %> &middot; <%= @subject.department.name %></p>
        <p class="text-gray-500">Teacher: <%= @subject.teacher.full_name %></p>
      </div>
      <% if @subject.teacher == Current.user || Current.user.admin? %>
        <div class="flex gap-2 flex-wrap">
          <%= link_to "Upload Material", new_subject_material_path(@subject), class: "rounded-md bg-blue-600 px-4 py-2 text-white text-sm font-medium hover:bg-blue-700 whitespace-nowrap" %>
          <%= link_to "Manage Files", subject_materials_path(@subject), class: "rounded-md bg-gray-200 px-4 py-2 text-sm font-medium hover:bg-gray-300 whitespace-nowrap" %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <div class="bg-white rounded-lg shadow p-6">
      <h2 class="text-lg font-semibold mb-3">
        <%= link_to "Materials", subject_materials_path(@subject), class: "text-blue-600 hover:text-blue-800" %>
      </h2>
      <% if @subject.materials.kept.any? %>
        <ul class="space-y-2">
          <% @subject.materials.kept.last(5).each do |material| %>
            <% if material.file.attached? %>
              <% file = material.file %>
              <% if file.image? %>
                <% preview_type = "image" %>
              <% elsif file.video? %>
                <% preview_type = "video" %>
              <% elsif file.audio? %>
                <% preview_type = "audio" %>
              <% elsif file.content_type == "application/pdf" %>
                <% preview_type = "pdf" %>
              <% else %>
                <% preview_type = nil %>
              <% end %>
            <% else %>
              <% preview_type = nil %>
            <% end %>
            <li class="text-sm flex items-center justify-between gap-3 p-1.5 hover:bg-gray-50 rounded transition-colors group">
              <div class="flex items-center gap-2 min-w-0 flex-1">
                <!-- Icon -->
                <span class="text-gray-400 group-hover:text-blue-600 transition-colors shrink-0">
                  <% if preview_type == "pdf" %>
                    <svg class="w-4 h-4 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
                    </svg>
                  <% elsif preview_type == "video" %>
                    <svg class="w-4 h-4 text-purple-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
                    </svg>
                  <% elsif preview_type == "audio" %>
                    <svg class="w-4 h-4 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3"></path>
                    </svg>
                  <% elsif preview_type == "image" %>
                    <svg class="w-4 h-4 text-orange-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                    </svg>
                  <% else %>
                    <svg class="w-4 h-4 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                    </svg>
                  <% end %>
                </span>
                
                <% if preview_type.present? %>
                  <button class="font-medium text-blue-600 hover:underline cursor-pointer text-left truncate font-sans text-sm min-w-0 max-w-[150px] sm:max-w-[200px]" onclick="showLightbox('<%= rails_blob_path(material.file, only_path: true) %>', '<%= preview_type %>', '<%= j material.title %>')">
                    <%= material.title %>
                  </button>
                <% else %>
                  <%= link_to material.title, subject_material_path(@subject, material, download: true), class: "font-medium text-blue-600 hover:underline truncate max-w-[150px] sm:max-w-[200px]", data: { turbo: false } %>
                <% end %>
                <span class="text-xs text-gray-400 shrink-0"><%= time_ago_in_words(material.created_at) %> ago</span>
              </div>
              
              <!-- Download link -->
              <%= link_to subject_material_path(@subject, material, download: true), class: "text-gray-400 hover:text-gray-600 shrink-0 p-1 hover:bg-gray-100 rounded", title: "Download", data: { turbo: false } do %>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
                </svg>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="text-gray-500 text-sm">No materials uploaded yet.</p>
      <% end %>
    </div>

    <div class="bg-white rounded-lg shadow p-6">
      <h2 class="text-lg font-semibold mb-3">Recent Posts</h2>
      <p class="text-gray-500 text-sm">No posts yet.</p>
    </div>
  </div>
</div>
