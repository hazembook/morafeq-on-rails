<div class="max-w-6xl mx-auto px-4 py-6">
  <!-- Subject Header -->
  <div class="bg-white rounded-2xl border border-gray-200 shadow-sm p-6 mb-6">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-6">
      <div>
        <%= link_to "← Back to Subjects", subjects_path, class: "text-sm text-blue-600 hover:text-blue-800" %>
        <h1 class="text-3xl font-extrabold text-gray-900 mt-2"><%= @subject.name %></h1>
        <p class="text-sm text-gray-500 mt-1 font-medium"><%= @subject.code %> &middot; Department of <%= @subject.department.name %></p>
        <p class="text-sm text-gray-600 mt-0.5">Instructor: <span class="font-semibold"><%= @subject.teacher.full_name %></span></p>
      </div>
      
      <div class="flex gap-2 flex-wrap">
        <% if @subject.chat_room %>
          <%= link_to chat_room_path(@subject.chat_room), class: "inline-flex items-center gap-1.5 rounded-lg bg-blue-50 px-4 py-2.5 text-blue-700 text-sm font-semibold hover:bg-blue-100 transition-colors" do %>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
            </svg>
            Class Chat Room
          <% end %>
        <% end %>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- Main Content Column -->
    <div class="lg:col-span-2 space-y-6">
      <!-- Materials Card -->
      <div class="bg-white rounded-2xl border border-gray-200 shadow-sm p-6">
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-lg font-bold text-gray-900 flex items-center gap-2">
            <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
            </svg>
            Subject Materials
          </h2>
          <%= link_to "View All", subject_materials_path(@subject), class: "text-xs font-semibold text-blue-600 hover:text-blue-800" %>
        </div>

        <% if @materials.any? %>
          <ul class="divide-y divide-gray-100" data-lightbox-gallery="subject-materials">
            <% @materials.each do |material| %>
              <% preview_type = nil %>
              <% if material.file.attached? %>
                <% file = material.file %>
                <% if file.image? %>
                  <% preview_type = "image" %>
                <% elsif file.video? %>
                  <% preview_type = "video" %>
                <% elsif file.audio? %>
                  <% preview_type = "audio" %>
                <% elsif file.content_type == "application/pdf" %>
                  <% preview_type = "pdf" %>
                <% end %>
              <% end %>
              <li class="py-3 flex items-center justify-between gap-3 group">
                <div class="flex items-center gap-3 min-w-0 flex-1">
                  <span class="p-1.5 bg-gray-50 rounded text-gray-400 group-hover:text-blue-600 transition-colors shrink-0">
                    <% if preview_type == "pdf" %>
                      <svg class="w-4 h-4 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path></svg>
                    <% elsif preview_type == "video" %>
                      <svg class="w-4 h-4 text-purple-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
                    <% elsif preview_type == "audio" %>
                      <svg class="w-4 h-4 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3"></path></svg>
                    <% elsif preview_type == "image" %>
                      <svg class="w-4 h-4 text-orange-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                    <% else %>
                      <svg class="w-4 h-4 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
                    <% end %>
                  </span>
                  
                  <% if preview_type.present? %>
                    <button class="font-semibold text-blue-600 hover:text-blue-800 hover:underline cursor-pointer text-left truncate font-sans text-sm min-w-0 max-w-[200px] sm:max-w-sm lightbox-trigger" data-src="<%= rails_storage_proxy_path(material.file, only_path: true) %>" data-download="<%= subject_material_path(@subject, material, download: true) %>" data-type="<%= preview_type %>" data-title="<%= j material.title %>" onclick="openLightboxGallery(this)">
                      <%= material.title %>
                    </button>
                  <% else %>
                    <%= link_to material.title, subject_material_path(@subject, material, download: true), class: "font-semibold text-blue-600 hover:text-blue-800 hover:underline truncate max-w-[200px] sm:max-w-sm", data: { turbo: false } %>
                  <% end %>
                  <span class="text-xs text-gray-400 shrink-0"><%= time_ago_in_words(material.created_at) %> ago</span>
                </div>
                
                <%= link_to subject_material_path(@subject, material, download: true), class: "text-gray-400 hover:text-gray-600 p-1 hover:bg-gray-100 rounded shrink-0 transition-colors", title: "Download", data: { turbo: false } do %>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
                <% end %>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p class="text-sm text-gray-500 py-2">No materials uploaded yet.</p>
        <% end %>
      </div>

      <!-- Quizzes Card -->
      <div class="bg-white rounded-2xl border border-gray-200 shadow-sm p-6">
        <h2 class="text-lg font-bold text-gray-900 flex items-center gap-2 mb-4">
          <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"></path>
          </svg>
          Quizzes (Online Forms)
        </h2>

        <% if @quizzes.any? %>
          <div class="divide-y divide-gray-100">
            <% @quizzes.each do |quiz| %>
              <div class="py-3 flex items-center justify-between gap-4">
                <div class="min-w-0 flex-1">
                  <%= link_to quiz.title, subject_quiz_path(@subject, quiz), class: "font-semibold text-sm text-gray-900 hover:text-blue-600 block truncate" %>
                  <p class="text-xs text-gray-400 mt-0.5">Due: <%= quiz.due_at.strftime("%b %d, %Y %I:%M %p") %> &middot; Max points: <%= quiz.total_points %></p>
                </div>
                
                <div class="shrink-0 text-right">
                  <% if Current.user.student? %>
                    <% ans = QuizAnswer.joins(:quiz_question).where(quiz_questions: { quiz_id: quiz.id }, user_id: Current.user.id) %>
                    <% if ans.any? %>
                      <% total_score = ans.map(&:score).compact.sum %>
                      <% all_graded = ans.all? { |a| a.score.present? } %>
                      <span class="text-xs font-semibold px-2 py-0.5 rounded <%= all_graded ? 'bg-green-50 text-green-700 border border-green-200' : 'bg-yellow-50 text-yellow-700 border border-yellow-200' %>">
                        <%= all_graded ? "#{total_score} / #{quiz.total_points} pts" : "Pending Grade" %>
                      </span>
                    <% else %>
                      <%= link_to "Take Quiz", subject_quiz_path(@subject, quiz), class: "text-xs font-semibold text-blue-600 hover:underline" %>
                    <% end %>
                  <% else %>
                    <%= link_to "Grade", grade_subject_quiz_path(@subject, quiz), class: "text-xs font-semibold text-blue-600 hover:underline" %>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        <% else %>
          <p class="text-sm text-gray-500 py-2">No quizzes created yet.</p>
        <% end %>
      </div>

      <!-- Assignments Card -->
      <div class="bg-white rounded-2xl border border-gray-200 shadow-sm p-6">
        <h2 class="text-lg font-bold text-gray-900 flex items-center gap-2 mb-4">
          <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
          </svg>
          Assignments (File Worksheets)
        </h2>

        <% if @assignments.any? %>
          <div class="divide-y divide-gray-100">
            <% @assignments.each do |assignment| %>
              <div class="py-3 flex items-center justify-between gap-4">
                <div class="min-w-0 flex-1">
                  <%= link_to assignment.title, subject_assignment_path(@subject, assignment), class: "font-semibold text-sm text-gray-900 hover:text-blue-600 block truncate" %>
                  <p class="text-xs text-gray-400 mt-0.5">Due: <%= assignment.due_at.strftime("%b %d, %Y %I:%M %p") %> &middot; Max points: <%= assignment.total_points %></p>
                </div>
                
                <div class="shrink-0 text-right">
                  <% if Current.user.student? %>
                    <% sub = assignment.assignment_submissions.find_by(user_id: Current.user.id) %>
                    <% if sub.present? %>
                      <span class="text-xs font-semibold px-2 py-0.5 rounded <%= sub.score.present? ? 'bg-green-50 text-green-700 border border-green-200' : 'bg-yellow-50 text-yellow-700 border border-yellow-200' %>">
                        <%= sub.score.present? ? "#{sub.score} / #{assignment.total_points} pts" : "Pending Grade" %>
                      </span>
                    <% else %>
                      <%= link_to "Submit File", subject_assignment_path(@subject, assignment), class: "text-xs font-semibold text-blue-600 hover:underline" %>
                    <% end %>
                  <% else %>
                    <%= link_to "Grade", grade_subject_assignment_path(@subject, assignment), class: "text-xs font-semibold text-blue-600 hover:underline" %>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        <% else %>
          <p class="text-sm text-gray-500 py-2">No assignments created yet.</p>
        <% end %>
      </div>

      <!-- Schedule Card -->
      <div class="bg-white rounded-2xl border border-gray-200 shadow-sm p-6">
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-lg font-bold text-gray-900 flex items-center gap-2">
            <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            Timetable / Weekly Class
          </h2>
          <%= link_to "Manage", subject_schedules_path(@subject), class: "text-xs font-semibold text-blue-600 hover:text-blue-800" %>
        </div>

        <% if @schedules.any? %>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <% @schedules.each do |schedule| %>
              <div class="p-3 bg-gray-50 rounded-xl border border-gray-100 flex items-start gap-3">
                <div class="p-2 bg-white text-blue-600 rounded-lg shadow-sm border border-gray-200/50 shrink-0">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                </div>
                <div class="min-w-0">
                  <p class="font-bold text-xs text-gray-900"><%= %w[Sunday Monday Tuesday Wednesday Thursday Friday Saturday][schedule.day] %></p>
                  <p class="text-xs text-gray-500 mt-0.5"><%= schedule.start_time.strftime("%I:%M %p") %> - <%= schedule.end_time.strftime("%I:%M %p") %></p>
                  <p class="text-[10px] text-gray-400 font-medium">Room: <%= schedule.room %></p>
                </div>
              </div>
            <% end %>
          </div>
        <% else %>
          <p class="text-sm text-gray-500 py-2">No timetable entries added.</p>
        <% end %>
      </div>
    </div>

    <!-- Sidebar Column -->
    <div class="space-y-6">
      <!-- Attendance Statistics Card -->
      <div class="bg-white rounded-2xl border border-gray-200 shadow-sm p-6">
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-lg font-bold text-gray-900 flex items-center gap-2">
            <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            Attendance
          </h2>
          <%= link_to "Details", subject_attendances_path(@subject), class: "text-xs font-semibold text-blue-600 hover:text-blue-800" %>
        </div>

        <% if Current.user.student? %>
          <% if @attendance_rate.present? %>
            <div class="text-center py-4">
              <span class="text-xs font-semibold text-gray-400 uppercase tracking-wide">Your Attendance Rate</span>
              <p class="text-4xl font-extrabold text-blue-600 mt-1 font-sans"><%= @attendance_rate %>%</p>
              <div class="grid grid-cols-2 gap-2 mt-4 text-xs font-medium text-gray-500">
                <div class="bg-green-50 text-green-700 py-1.5 rounded-lg">Present: <%= @student_attendances.where(status: "present").count %></div>
                <div class="bg-red-50 text-red-700 py-1.5 rounded-lg">Absent: <%= @student_attendances.where(status: "absent").count %></div>
              </div>
            </div>
          <% else %>
            <p class="text-sm text-gray-500 py-2">No attendance records registered yet.</p>
          <% end %>
        <% else %>
          <div class="text-center py-4 space-y-3">
            <div>
              <span class="text-xs font-semibold text-gray-400 uppercase tracking-wide">Enrolled Students</span>
              <p class="text-3xl font-extrabold text-gray-900 mt-1 font-sans"><%= @student_count %></p>
            </div>
            <%= link_to "Record Today's Attendance", record_subject_attendances_path(@subject), class: "inline-block w-full text-center bg-blue-600 hover:bg-blue-700 text-white rounded-lg py-2 text-sm font-semibold shadow-sm" %>
          </div>
        <% end %>
      </div>

      <!-- Recent Announcements / Scoped Posts Card -->
      <div class="bg-white rounded-2xl border border-gray-200 shadow-sm p-6">
        <h2 class="text-lg font-bold text-gray-900 flex items-center gap-2 mb-4">
          <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z"></path>
          </svg>
          Subject Announcements
        </h2>

        <% if @posts.any? %>
          <div class="space-y-4">
            <% @posts.each do |post| %>
              <div class="text-xs border-b border-gray-100 pb-3 last:border-0 last:pb-0">
                <div class="flex justify-between items-center text-gray-400 mb-1">
                  <span class="font-semibold text-gray-700"><%= post.author.full_name %></span>
                  <span><%= time_ago_in_words(post.created_at) %> ago</span>
                </div>
                <p class="text-gray-600 leading-relaxed truncate-3-lines"><%= post.content %></p>
              </div>
            <% end %>
          </div>
        <% else %>
          <p class="text-sm text-gray-500 py-2">No announcements posted yet.</p>
        <% end %>
      </div>

      <!-- Quick Actions for Teachers / Admins -->
      <% if @subject.teacher == Current.user || Current.user.admin? %>
        <div class="bg-white rounded-2xl border border-gray-200 shadow-sm p-6">
          <h2 class="text-sm font-bold text-gray-900 uppercase tracking-wide mb-4">Teacher Panel</h2>
          <div class="grid grid-cols-1 gap-2.5">
            <%= link_to "Upload Material", new_subject_material_path(@subject), class: "w-full text-center bg-gray-50 hover:bg-gray-100/80 text-gray-700 border border-gray-200 rounded-lg py-2.5 text-xs font-bold transition-all shadow-sm" %>
            <%= link_to "Create a Quiz", new_subject_quiz_path(@subject), class: "w-full text-center bg-gray-50 hover:bg-gray-100/80 text-gray-700 border border-gray-200 rounded-lg py-2.5 text-xs font-bold transition-all shadow-sm" %>
            <%= link_to "Create Assignment", new_subject_assignment_path(@subject), class: "w-full text-center bg-gray-50 hover:bg-gray-100/80 text-gray-700 border border-gray-200 rounded-lg py-2.5 text-xs font-bold transition-all shadow-sm" %>
            <%= link_to "Add Schedule Slot", new_subject_schedule_path(@subject), class: "w-full text-center bg-gray-50 hover:bg-gray-100/80 text-gray-700 border border-gray-200 rounded-lg py-2.5 text-xs font-bold transition-all shadow-sm" %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
