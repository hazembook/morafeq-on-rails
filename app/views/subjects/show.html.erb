<div class="max-w-4xl mx-auto">
  <div class="bg-white rounded-lg shadow p-6 mb-6">
    <div class="flex items-start justify-between">
      <div>
        <h1 class="text-2xl font-bold"><%= @subject.name %></h1>
        <p class="text-gray-500"><%= @subject.code %> &middot; <%= @subject.department.name %></p>
        <p class="text-gray-500">Teacher: <%= @subject.teacher.full_name %></p>
      </div>
      <div class="flex gap-2">
        <% if @subject.teacher == Current.user || Current.user.admin? %>
          <%= link_to "Upload Material", new_subject_material_path(@subject), class: "rounded-md bg-blue-600 px-4 py-2 text-white text-sm font-medium hover:bg-blue-700" %>
          <%= link_to "Manage Files", subject_materials_path(@subject), class: "rounded-md bg-gray-200 px-4 py-2 text-sm font-medium hover:bg-gray-300" %>
        <% end %>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <div class="bg-white rounded-lg shadow p-6">
      <h2 class="text-lg font-semibold mb-3">
        <%= link_to "Materials", subject_materials_path(@subject), class: "text-blue-600 hover:text-blue-800" %>
      </h2>
      <% if @subject.materials.kept.any? %>
        <ul class="space-y-2">
          <% @subject.materials.kept.last(5).each do |material| %>
            <li class="text-sm">
              <%= link_to material.title, subject_material_path(@subject, material), class: "text-blue-600 hover:underline" %>
              <span class="text-gray-400"><%= time_ago_in_words(material.created_at) %> ago</span>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="text-gray-500 text-sm">No materials uploaded yet.</p>
      <% end %>
    </div>

    <div class="bg-white rounded-lg shadow p-6">
      <h2 class="text-lg font-semibold mb-3">Recent Posts</h2>
      <p class="text-gray-500 text-sm">No posts yet.</p>
    </div>
  </div>
</div>
