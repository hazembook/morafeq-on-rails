<% 
  is_self = message.user == Current.user
  is_private = message.chat_room.is_private?
  
  # Bubble styles
  bubble_classes = if is_self
    "bg-[#d9fdd3] text-gray-900 rounded-2xl rounded-tr-none shadow-sm border border-green-100/50"
  else
    "bg-white text-gray-900 rounded-2xl rounded-tl-none shadow-sm border border-gray-150"
  end

  # Footer styling
  footer_border = is_self ? "border-green-200/50" : "border-gray-100"
  time_class = is_self ? "text-green-700/80" : "text-gray-400"
  seen_class = is_self ? "text-green-700/80" : "text-gray-400"
  delete_class = if is_self
    "text-red-700 hover:text-red-900"
  else
    "text-red-500 hover:text-red-700"
  end
%>

<div id="<%= dom_id(message) %>" class="flex gap-2 <%= is_self ? "justify-end" : "" %>">
  <div class="<%= bubble_classes %> px-4 py-2.5 max-w-[75%] animate-fade-in-up">
    <% if !is_private && !is_self %>
      <% 
        name_colors = ["text-blue-600", "text-green-600", "text-purple-600", "text-orange-600", "text-rose-600"]
        name_color = name_colors[message.user.id % name_colors.size]
      %>
      <p class="text-[11px] font-bold <%= name_color %> mb-0.5"><%= message.user.full_name %></p>
    <% end %>
    
    <% if message.content.present? %>
      <p class="text-sm leading-relaxed break-words"><%= message.content %></p>
    <% end %>

    <% if message.attachments.attached? && message.attachments.any? %>
      <% images, files = message.attachments.partition(&:image?) %>

      <div class="mt-2 space-y-2" data-lightbox-gallery="message-<%= message.id %>">
        <%# Render Images Grid %>
        <% if images.any? %>
          <div class="grid gap-1 max-w-sm rounded-lg overflow-hidden border border-gray-200">
            <% images.each do |attachment| %>
              <div class="relative cursor-zoom-in aspect-square overflow-hidden bg-gray-100 lightbox-trigger" data-src="<%= rails_storage_proxy_path(attachment, only_path: true) %>" data-download="<%= rails_storage_proxy_path(attachment, disposition: "attachment", only_path: true) %>" data-type="image" data-title="<%= j attachment.filename.to_s %>" onclick="openLightboxGallery(this)">
                <%= image_tag attachment, class: "w-full h-full object-cover hover:scale-105 transition-transform duration-300" %>
              </div>
            <% end %>
          </div>
        <% end %>

        <%# Render Documents & Non-Images %>
        <% if files.any? %>
          <div class="grid grid-cols-1 gap-2 max-w-xs">
            <% files.each do |attachment| %>
              <% if attachment.video? %>
                <% preview_type = "video" %>
              <% elsif attachment.audio? %>
                <% preview_type = "audio" %>
              <% elsif attachment.content_type == "application/pdf" %>
                <% preview_type = "pdf" %>
              <% else %>
                <% preview_type = nil %>
              <% end %>
              <div class="flex items-center justify-between p-2 bg-white rounded-lg border border-gray-200 transition-colors group gap-2 text-gray-900">
                <div class="flex items-center gap-2 min-w-0 flex-1">
                  <div class="p-1.5 bg-gray-50 rounded-md border border-gray-100 text-gray-500 shrink-0">
                    <% if preview_type == "pdf" %>
                      <svg class="w-4 h-4 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
                      </svg>
                    <% elsif preview_type == "video" %>
                      <svg class="w-4 h-4 text-purple-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
                      </svg>
                    <% elsif preview_type == "audio" %>
                      <svg class="w-4 h-4 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3"></path>
                      </svg>
                    <% else %>
                      <svg class="w-4 h-4 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                      </svg>
                    <% end %>
                  </div>
                  
                  <div class="min-w-0 flex-1">
                    <span class="block text-xs font-medium text-gray-700 truncate">
                      <%= attachment.filename %>
                    </span>
                    <span class="block text-[9px] text-gray-400">
                      <%= number_to_human_size(attachment.byte_size) %>
                    </span>
                  </div>
                </div>

                <div class="flex items-center gap-1 shrink-0">
                  <% if preview_type.present? %>
                    <button class="px-1.5 py-0.5 text-[10px] font-medium text-blue-600 bg-blue-50 hover:bg-blue-100 rounded border border-blue-200 transition-colors cursor-pointer lightbox-trigger font-sans" data-src="<%= rails_storage_proxy_path(attachment, only_path: true) %>" data-download="<%= rails_storage_proxy_path(attachment, disposition: "attachment", only_path: true) %>" data-type="<%= preview_type %>" data-title="<%= j attachment.filename.to_s %>" onclick="openLightboxGallery(this)">
                      <%= t("common.preview") %>
                    </button>
                  <% end %>
                  <%= link_to rails_storage_proxy_path(attachment, disposition: "attachment", only_path: true), class: "p-1 text-gray-500 hover:text-gray-700 bg-white hover:bg-gray-50 rounded border border-gray-200 transition-colors cursor-pointer", title: t("common.download"), download: true do %>
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
                    </svg>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>

    <div class="flex items-center justify-between gap-4 mt-1 border-t <%= footer_border %> pt-1">
      <span class="text-[10px] <%= time_class %> font-light"><%= t("datetime.time_ago", time: time_ago_in_words(message.created_at)) %></span>
      
      <div class="flex items-center gap-2">
        <% if is_self %>
          <span id="message_<%= message.id %>_seen" class="text-[10px] <%= seen_class %> font-light">
            <% if message.seen_by?(Current.user) %>
              <%= t("chats.seen") %>
            <% else %>
              <%= t("chats.sent") %>
            <% end %>
          </span>
        <% end %>

        <% is_author_recent = is_self && message.created_at > 5.minutes.ago %>
        <% is_teacher = !is_private && message.chat_room.subject&.teacher == Current.user %>
        <% is_admin = Current.user.admin? %>
        <% if is_author_recent || is_teacher || is_admin %>
          <%= button_to is_author_recent ? t("chats.unsend_button") : t("common.delete"), chat_room_message_path(message.chat_room, message), method: :delete, class: "text-[10px] #{delete_class} underline focus:outline-none cursor-pointer bg-transparent border-0 p-0", data: { turbo_confirm: is_author_recent ? t("chats.confirm_unsend") : t("chats.confirm_delete") } %>
        <% end %>
      </div>
    </div>
  </div>
</div>
