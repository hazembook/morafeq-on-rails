<div id="<%= dom_id(message) %>" class="flex gap-2 <%= message.user == Current.user ? 'justify-end' : '' %>">
  <div class="<%= message.user == Current.user ? 'bg-blue-600 text-white' : 'bg-gray-100 text-gray-900' %> rounded-lg px-3 py-2 max-w-[75%]">
    <p class="text-xs font-medium <%= message.user == Current.user ? 'text-blue-200' : 'text-gray-500' %>"><%= message.user.full_name %></p>
    <p class="text-sm"><%= message.content %></p>
    <p class="text-xs <%= message.user == Current.user ? 'text-blue-200' : 'text-gray-400' %> mt-0.5"><%= time_ago_in_words(message.created_at) %> ago</p>
  </div>
</div>
