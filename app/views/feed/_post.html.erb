<div class="bg-white rounded-lg shadow p-4">
  <div class="flex items-start gap-3">
    <div class="flex-1">
      <div class="flex flex-wrap items-center gap-x-2 gap-y-0.5 mb-1">
        <span class="font-medium text-sm"><%= post.author.full_name %></span>
        <span class="text-xs text-gray-400"><%= time_ago_in_words(post.created_at) %> ago</span>
        <% if post.pinned? %>
          <span class="text-xs bg-yellow-100 text-yellow-700 px-1.5 py-0.5 rounded">Official</span>
        <% end %>
      </div>
      <p class="text-sm text-gray-700"><%= post.content %></p>
      <% if post.attachments.any? %>
        <div class="mt-2 flex gap-2">
          <% post.attachments.each do |attachment| %>
            <%= link_to attachment.filename, attachment, class: "text-xs text-blue-600 hover:underline" %>
          <% end %>
        </div>
      <% end %>
      <div class="mt-2 flex items-center gap-1.5 flex-wrap">
        <span class="px-2 py-0.5 rounded-md text-[10px] font-semibold tracking-wide uppercase <%= scope_badge_class(post.scope_type) %>">
          <%= post.scope_type %>
        </span>
        <span class="text-xs text-gray-500 font-medium">
          <%= post.scope.name %>
        </span>
      </div>
    </div>
  </div>
</div>
