<div class="bg-white rounded-lg shadow p-4">
  <div class="flex items-start gap-3">
    <div class="flex-1">
      <div class="flex flex-wrap items-center gap-x-2 gap-y-0.5 mb-1">
        <span class="font-medium text-sm"><%= post.author.full_name %></span>
        <span class="text-xs text-gray-400"><%= time_ago_in_words(post.created_at) %> ago</span>
        <% if post.pinned? %>
          <span class="text-xs bg-yellow-100 text-yellow-700 px-1.5 py-0.5 rounded">Official</span>
        <% end %>
      </div>
      <p class="text-sm text-gray-700"><%= post.content %></p>
      <% if post.attachments.any? %>
        <div class="mt-2 space-y-2">
          <% post.attachments.each do |attachment| %>
            <% if attachment.image? %>
              <div class="block max-w-lg overflow-hidden rounded-lg border border-gray-200 mt-2 cursor-zoom-in" onclick="showLightbox(this.querySelector('img').src)">
                <%= image_tag attachment, class: "w-full max-h-72 object-cover hover:scale-[1.02] transition-transform duration-300" %>
              </div>
            <% else %>
              <div class="flex items-center gap-1.5 mt-1">
                <svg class="w-4 h-4 text-gray-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                </svg>
                <%= link_to attachment.filename, attachment, target: "_blank", class: "text-xs text-blue-600 hover:underline font-medium" %>
              </div>
            <% end %>
          <% end %>
        </div>
      <% end %>
      <div class="mt-2 flex items-center gap-1.5 flex-wrap">
        <span class="px-2 py-0.5 rounded-md text-[10px] font-semibold tracking-wide uppercase <%= scope_badge_class(post.scope_type) %>">
          <%= post.scope_type || "General" %>
        </span>
        <span class="text-xs text-gray-500 font-medium">
          <%= post.scope ? post.scope.name : "University-wide" %>
        </span>
      </div>
    </div>
  </div>
</div>
