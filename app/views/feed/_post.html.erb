<div id="<%= dom_id(post) %>"
     class="bg-white rounded-xl shadow-sm border border-gray-200 hover:border-gray-300 transition-colors cursor-pointer"
     data-controller="post-actions"
     data-action="click->post-actions#navigateToPost"
     data-post-url="<%= feed_path(post) %>">

  <div class="p-4">
    <!-- Header: Author name, [Official], [Scope] -->
    <div class="flex items-start justify-between gap-2 mb-2">
      <div class="flex flex-wrap items-center gap-x-2 gap-y-0.5 text-xs text-gray-500 min-w-0">
        <span class="font-semibold text-gray-800 truncate"><%= post.author.full_name %></span>
        <% if post.pinned? %>
          <span class="shrink-0 text-[10px] bg-red-100 text-red-700 font-semibold px-1.5 py-0.5 rounded-full uppercase tracking-wider scale-90 <%= I18n.locale == :ar ? 'origin-right' : 'origin-left' %>"><%= t("feed.official") %></span>
        <% end %>
        <span class="px-1.5 py-0.5 rounded text-[10px] font-semibold uppercase tracking-wide shrink-0 <%= scope_badge_class(post.scope_type) %>">
          <%= post.scope_type.present? ? t("feed.scopes.#{post.scope_type.downcase}") : t("feed.scope_general") %>
        </span>
        <span class="text-[11px] text-gray-500 font-medium shrink-0 max-w-[120px] truncate" title="<%= post.scope&.name || t("feed.scope_univ") %>">
          <%= post.scope ? post.scope.name : t("feed.scope_univ") %>
        </span>
      </div>

      <!-- 3-dot dropdown menu (author or admin only) -->
      <% if Current.user && (post.author == Current.user || Current.user.admin?) %>
        <div class="shrink-0 relative" data-controller="dropdown" data-action="click->dropdown#toggle">
          <button class="p-1 hover:bg-gray-100 rounded-full transition-colors text-gray-400 hover:text-gray-600 cursor-pointer" type="button" aria-label="<%= t("common.actions") %>">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <circle cx="12" cy="5" r="1.5"/>
              <circle cx="12" cy="12" r="1.5"/>
              <circle cx="12" cy="19" r="1.5"/>
            </svg>
          </button>
          <div data-dropdown-target="menu" class="hidden absolute end-0 top-full mt-1 w-36 bg-white rounded-lg shadow-lg border border-gray-200 py-1 z-50 origin-top-end">
            <%= link_to edit_feed_path(post), data: { turbo_frame: "_top" }, class: "flex items-center gap-2 px-3 py-2 text-sm text-gray-700 hover:bg-gray-50 transition-colors no-underline" do %>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
              </svg>
              <%= t("common.edit") %>
            <% end %>
            <%= button_to feed_path(post), method: :delete, class: "flex items-center gap-2 w-full px-3 py-2 text-sm text-red-600 hover:bg-red-50 transition-colors cursor-pointer border-0 bg-transparent text-start", data: { turbo_frame: "_top", turbo_confirm: t("common.confirm_delete") } do %>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
              </svg>
              <%= t("common.delete") %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>

    <!-- Post content -->
    <div class="text-sm text-gray-800 whitespace-pre-line leading-relaxed mb-3"><%= post.content %></div>

    <!-- Attachments: full preview grid for images, detailed cards for files -->
    <% if post.attachments.any? %>
      <% images, files = post.attachments.partition(&:image?) %>
      <div class="mt-2 space-y-2 mb-3" data-lightbox-gallery="post-<%= post.id %>">
        <% if images.any? %>
          <% if images.size == 1 %>
            <% attachment = images.first %>
            <div class="block max-w-lg overflow-hidden rounded-lg border border-gray-200 cursor-zoom-in lightbox-trigger" data-src="<%= rails_storage_proxy_path(attachment, only_path: true) %>" data-download="<%= rails_storage_proxy_path(attachment, disposition: "attachment", only_path: true) %>" data-type="image" data-title="<%= j attachment.filename.to_s %>" onclick="event.stopPropagation(); openLightboxGallery(this)">
              <%= image_tag attachment, class: "w-full max-h-64 object-cover hover:scale-[1.02] transition-transform duration-300" %>
            </div>
          <% else %>
            <div class="grid gap-1 max-w-lg <%= images.size == 2 ? "grid-cols-2" : "grid-cols-3" %> rounded-lg overflow-hidden border border-gray-200">
              <% images.each_with_index do |attachment, idx| %>
                <div class="relative cursor-zoom-in aspect-square overflow-hidden bg-gray-100 lightbox-trigger" data-src="<%= rails_storage_proxy_path(attachment, only_path: true) %>" data-download="<%= rails_storage_proxy_path(attachment, disposition: "attachment", only_path: true) %>" data-type="image" data-title="<%= j attachment.filename.to_s %>" onclick="event.stopPropagation(); openLightboxGallery(this)">
                  <%= image_tag attachment, class: "w-full h-full object-cover hover:scale-105 transition-transform duration-300" %>
                  <% if idx == 2 && images.size > 3 %>
                    <div class="absolute inset-0 bg-black/50 flex items-center justify-center text-white font-bold text-lg pointer-events-none">
                      +<%= images.size - 2 %>
                    </div>
                  <% end %>
                </div>
                <% break if idx == 2 && images.size > 3 %>
              <% end %>
            </div>
          <% end %>
        <% end %>

        <% if files.any? %>
          <div class="grid grid-cols-1 gap-2 max-w-lg">
            <% files.each do |attachment| %>
              <% preview_type = if attachment.video? then "video" elsif attachment.audio? then "audio" elsif attachment.content_type == "application/pdf" then "pdf" end %>
              <div class="flex flex-col sm:flex-row sm:items-center justify-between p-3 bg-gray-50 hover:bg-gray-100/80 rounded-lg border border-gray-200/80 transition-colors group gap-3">
                <div class="flex items-center gap-3 min-w-0 flex-1 w-full">
                  <div class="p-2 bg-white rounded-md border border-gray-200 text-gray-500 group-hover:text-blue-600 transition-colors shrink-0">
                    <% if preview_type == "pdf" %>
                      <svg class="w-6 h-6 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"/>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 9h1.5M9 13h6m-6 4h6"/>
                      </svg>
                    <% elsif preview_type == "video" %>
                      <svg class="w-6 h-6 text-purple-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/>
                      </svg>
                    <% elsif preview_type == "audio" %>
                      <svg class="w-6 h-6 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3"/>
                      </svg>
                    <% else %>
                      <svg class="w-6 h-6 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                      </svg>
                    <% end %>
                  </div>
                  <div class="min-w-0 flex-1">
                    <span class="block text-sm font-medium text-gray-700 truncate group-hover:text-blue-600 transition-colors"><%= attachment.filename %></span>
                    <span class="block text-[11px] text-gray-400"><%= number_to_human_size(attachment.byte_size) %></span>
                  </div>
                </div>
                <div class="flex items-center gap-2 self-end sm:self-auto shrink-0">
                  <% if preview_type.present? %>
                    <button class="px-2.5 py-1 text-xs font-medium text-blue-600 bg-blue-50 hover:bg-blue-100 rounded border border-blue-200 transition-colors cursor-pointer font-sans lightbox-trigger" data-src="<%= rails_storage_proxy_path(attachment, only_path: true) %>" data-download="<%= rails_storage_proxy_path(attachment, disposition: "attachment", only_path: true) %>" data-type="<%= preview_type %>" data-title="<%= j attachment.filename.to_s %>" onclick="event.stopPropagation(); openLightboxGallery(this)">
                      <%= t("feed.preview") %>
                    </button>
                  <% end %>
                  <%= link_to rails_storage_proxy_path(attachment, disposition: "attachment", only_path: true), class: "p-1.5 text-gray-500 hover:text-gray-700 bg-white hover:bg-gray-50 rounded border border-gray-200 transition-colors cursor-pointer", title: t("common.download"), download: true, onclick: "event.stopPropagation()" do %>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
                    </svg>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>

    <!-- Footer: comments + read status + timestamp -->
    <div class="pt-3 border-t border-gray-100 flex flex-wrap items-center justify-between gap-3 text-gray-500 text-xs font-semibold select-none">
      <div class="flex flex-wrap items-center gap-3">
        <% unless post.comments_disabled? %>
          <%= link_to feed_path(post), data: { turbo_frame: "_top" }, class: "flex items-center gap-1.5 px-3 py-1.5 hover:bg-gray-100 rounded-full transition-colors text-gray-500 hover:text-gray-700 decoration-none no-underline cursor-pointer" do %>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
            </svg>
            <span><%= post.comments.count %> <%= t("feed.comments") %></span>
          <% end %>
        <% end %>

        <%= turbo_frame_tag "read_status_#{dom_id(post)}", src: read_status_feed_path(post), loading: :lazy do %>
          <div class="h-5"></div>
        <% end %>
      </div>

      <div class="flex flex-wrap items-center gap-x-2 gap-y-0.5 text-xs text-gray-400">
        <span><%= t("datetime.time_ago", time: time_ago_in_words(post.created_at)) %></span>
        <% if post.author == Current.user && post.post_views_count.to_i > 0 %>
          <span class="text-gray-300">•</span>
          <details class="relative inline-flex" onclick="event.stopPropagation()">
            <summary class="list-none flex items-center gap-1 text-blue-500 hover:text-blue-700 cursor-pointer text-xs font-semibold select-none">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
              </svg>
              <%= post.post_views_count %>
            </summary>
            <div class="absolute end-0 top-full mt-1 w-56 bg-white rounded-lg shadow-lg border border-gray-200 py-2 z-50 max-h-48 overflow-y-auto">
              <div class="px-3 py-1 text-[10px] font-semibold text-gray-400 uppercase tracking-wider"><%= t("feed.read_by", count: post.post_views_count) %></div>
              <% post.post_views.includes(:user).order(created_at: :desc).each do |view| %>
                <div class="px-3 py-1.5 flex items-center justify-between gap-2 text-xs text-gray-700 hover:bg-gray-50">
                  <span class="truncate"><%= view.user.full_name %></span>
                  <span class="shrink-0 text-gray-400"><%= time_ago_in_words(view.created_at) %></span>
                </div>
              <% end %>
            </div>
          </details>
        <% end %>
      </div>
    </div>
  </div>
</div>
