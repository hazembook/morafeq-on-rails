<% if post.author == Current.user %>
<% elsif PostView.exists?(post: post, user: Current.user) %>
  <span class="flex items-center gap-1 text-green-600">
    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
    </svg>
    <%= t("feed.read") %>
  </span>
<% else %>
  <%= button_to t("feed.mark_read"), mark_read_feed_path(post), method: :post, class: "flex items-center gap-1.5 px-3 py-1.5 hover:bg-green-50 rounded-full transition-colors text-green-600 hover:text-green-700 border-0 bg-transparent font-semibold text-xs cursor-pointer" %>
<% end %>
