<div class="max-w-3xl mx-auto px-4 py-6">
  <div class="mb-5">
    <%= link_to t("feed.back_to_feed"), feed_index_path, data: { turbo_action: "restore" }, class: "text-sm font-semibold text-gray-500 hover:text-blue-600 transition-colors flex items-center gap-1.5 no-underline hover:underline" %>
  </div>

  <div class="mb-6">
    <%= render "post", post: @post %>
  </div>

  <% unless @post.comments_disabled? %>
    <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-6">
      <h3 class="font-bold text-sm text-gray-900 mb-4 pb-2 border-b border-gray-100 flex items-center gap-2">
        <svg class="w-4 h-4 text-gray-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
        </svg>
        <%= t("feed.comments") %> (<%= @post.comments.count %>)
      </h3>

      <div class="mb-6">
        <%= form_with model: [ @post, Comment.new ], url: feed_comments_path(@post), local: true, class: "space-y-3" do |f| %>
          <div>
            <%= f.text_area :content, placeholder: t("feed.comment_placeholder"), rows: 3, class: "w-full rounded-lg border-gray-300 shadow-inner focus:border-blue-500 focus:ring-blue-500 text-sm p-3 bg-gray-50 focus:bg-white transition-all resize-none", required: true %>
          </div>
          <div class="flex justify-end">
            <%= f.submit t("feed.add_comment"), class: "rounded-full bg-blue-600 px-5 py-1.5 text-white text-xs font-bold hover:bg-blue-700 cursor-pointer shadow transition-all hover:scale-102 border-0" %>
          </div>
        <% end %>
      </div>

      <div class="space-y-4">
        <% if @comments.any? %>
          <% @comments.each do |comment| %>
            <div class="flex gap-3">
              <div class="flex flex-col items-center">
                <div class="w-7 h-7 rounded-full bg-blue-50 flex items-center justify-center text-blue-600 font-bold text-xs shrink-0 select-none">
                  <%= comment.user.full_name[0].upcase %>
                </div>
                <div class="w-[2px] grow bg-gray-100 mt-2"></div>
              </div>

              <div class="flex-1 min-w-0 pb-4">
                <div class="flex flex-wrap items-center gap-x-2 gap-y-0.5 text-xs text-gray-500 mb-1">
                  <span class="font-semibold text-gray-800"><%= comment.user.full_name %></span>
                  <span class="text-gray-300">•</span>
                  <span data-controller="timeago" data-timeago-datetime-value="<%= comment.created_at.iso8601 %>" data-timeago-format-value="<%= t("datetime.time_ago", time: "%{time}") %>"><%= t("datetime.time_ago", time: time_ago_in_words(comment.created_at)) %></span>
                </div>
                <p class="text-sm text-gray-700 whitespace-pre-line leading-relaxed"><%= comment.content %></p>
              </div>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
