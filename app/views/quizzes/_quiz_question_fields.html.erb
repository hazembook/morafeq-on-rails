<div class="p-4 bg-gray-50 rounded-xl border border-gray-200 space-y-3 relative" data-nested-form-wrapper="true">
  <div class="flex items-center justify-between">
    <span class="text-xs font-semibold text-gray-500 uppercase tracking-wide" data-question-label="true">Question</span>
    <%= q_form.hidden_field :_destroy %>
    <button type="button" data-action="click->nested-form#remove" class="text-xs font-medium text-red-600 hover:text-red-800 transition duration-150 ease-in-out cursor-pointer">
      Remove Question
    </button>
  </div>
  
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div>
      <%= q_form.label :question_type, "Question Type", class: "block text-xs font-medium text-gray-500 mb-1" %>
      <%= q_form.select :question_type, [["Written Q&A", "written"], ["Multiple Choice (MCQ)", "mcq"], ["True / False", "true_false"], ["Matching Pairs", "match"]], {}, class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm" %>
    </div>
    <div>
      <%= q_form.label :points, "Points Value", class: "block text-xs font-medium text-gray-500 mb-1" %>
      <%= q_form.number_field :points, value: q_form.object.points || 5, class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm" %>
    </div>
  </div>

  <div>
    <%= q_form.label :question, "Question Text", class: "block text-xs font-medium text-gray-500 mb-1" %>
    <%= q_form.text_area :question, rows: 2, placeholder: "Type the question here...", class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm" %>
  </div>

  <div>
    <%= q_form.label :choices_text, "Options / Choices (leave blank for Written Q&A or True/False)", class: "block text-xs font-medium text-gray-500 mb-1" %>
    <%= q_form.text_area :choices_text, rows: 3, placeholder: "MCQ: One option per line (e.g. Option A)\nMatch: Left item : Right match per line (e.g. Paris : France)", class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm" %>
  </div>
</div>
