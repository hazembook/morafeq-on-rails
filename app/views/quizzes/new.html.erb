<div class="max-w-2xl mx-auto px-4 py-6">
  <div class="mb-6">
    <%= link_to "← Back to Subject", subject_path(@subject), class: "text-sm text-blue-600 hover:text-blue-800" %>
    <h1 class="text-2xl font-bold mt-2 text-gray-900">Create a New Quiz</h1>
    <p class="text-sm text-gray-500"><%= @subject.name %> (<%= @subject.code %>)</p>
  </div>

  <%= form_with model: [ @subject, @quiz ], class: "bg-white rounded-xl border border-gray-200 shadow-sm p-6 space-y-6" do |f| %>
    <% if @quiz.errors.any? %>
      <div class="bg-red-50 text-red-700 p-4 rounded-lg text-sm border border-red-200">
        <h3 class="font-semibold mb-1">Errors prevented this quiz from being saved:</h3>
        <ul class="list-disc list-inside">
          <% @quiz.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <%= f.label :title, "Quiz Title", class: "block text-sm font-semibold text-gray-700 mb-1" %>
      <%= f.text_field :title, placeholder: "e.g. Midterm Quiz, Assignment 1", class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm" %>
    </div>

    <div>
      <%= f.label :due_at, "Due Date & Time", class: "block text-sm font-semibold text-gray-700 mb-1" %>
      <%= f.datetime_local_field :due_at, class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm" %>
    </div>

    <div class="border-t border-gray-100 pt-6">
      <h2 class="text-lg font-bold text-gray-800 mb-4">Quiz Questions</h2>
      <div class="space-y-4">
        <%= f.fields_for :quiz_questions do |q_form| %>
          <div class="p-4 bg-gray-50 rounded-xl border border-gray-200 space-y-3 relative">
            <div class="flex items-center justify-between">
              <span class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Question <%= q_form.index + 1 %></span>
            </div>
            <div>
              <%= q_form.label :question, "Question Text", class: "block text-xs font-medium text-gray-500 mb-1" %>
              <%= q_form.text_area :question, rows: 2, placeholder: "Type the question here...", class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm" %>
            </div>
            <div>
              <%= q_form.label :points, "Points value", class: "block text-xs font-medium text-gray-500 mb-1" %>
              <%= q_form.number_field :points, value: q_form.object.points || 5, class: "w-32 rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm" %>
            </div>
          </div>
        <% end %>
      </div>
    </div>

    <div class="flex justify-end gap-3 border-t border-gray-100 pt-6">
      <%= link_to "Cancel", subject_path(@subject), class: "px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50" %>
      <%= f.submit "Create Quiz", class: "px-4 py-2 text-sm font-semibold text-white bg-blue-600 rounded-lg hover:bg-blue-700 shadow-sm cursor-pointer" %>
    </div>
  <% end %>
</div>
