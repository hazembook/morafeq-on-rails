<div class="max-w-2xl mx-auto px-4 py-6">
  <div class="mb-6">
    <%= link_to "← Back to Subject", subject_path(@subject), class: "text-sm text-blue-600 hover:text-blue-800" %>
    <h1 class="text-2xl font-bold mt-2 text-gray-900">Create a New Quiz</h1>
    <p class="text-sm text-gray-500"><%= @subject.name %> (<%= @subject.code %>)</p>
  </div>

  <%= form_with model: [ @subject, @quiz ], data: { controller: "nested-form" }, class: "bg-white rounded-xl border border-gray-200 shadow-sm p-6 space-y-6" do |f| %>
    <% if @quiz.errors.any? %>
      <div class="bg-red-50 text-red-700 p-4 rounded-lg text-sm border border-red-200">
        <h3 class="font-semibold mb-1">Errors prevented this quiz from being saved:</h3>
        <ul class="list-disc list-inside">
          <% @quiz.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <%= f.label :title, "Quiz Title", class: "block text-sm font-semibold text-gray-700 mb-1" %>
      <%= f.text_field :title, placeholder: "e.g. Midterm Quiz, Assignment 1", required: true, class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm" %>
    </div>

    <div>
      <%= f.label :due_at, "Due Date & Time", class: "block text-sm font-semibold text-gray-700 mb-1" %>
      <%= f.datetime_local_field :due_at, required: true, class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm" %>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 bg-blue-50 p-4 rounded-xl border border-blue-100">
      <div>
        <label for="template_select" class="block text-xs font-semibold text-blue-900 uppercase tracking-wide mb-1">Load Ready Template</label>
        <%= select_tag :template_select, options_for_select([["-- Blank / Custom Quiz --", ""], ["Quick Check (1 MCQ, 1 True/False)", "quick_check"], ["MCQ Quiz (3 MCQs)", "mcq_quiz"], ["Comprehensive Exam (All Types)", "comprehensive"]]),
                       data: { action: "change->nested-form#loadTemplate" },
                       class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm" %>
        <p class="text-[10px] text-blue-700 mt-1">Selecting a template will replace current questions with preset template fields.</p>
      </div>

      <div>
        <%= f.label :quiz_file, "Attach Quiz Document (PDF/Worksheet - Optional)", class: "block text-xs font-semibold text-blue-900 uppercase tracking-wide mb-1" %>
        <%= f.file_field :quiz_file, class: "w-full rounded-lg border border-gray-300 bg-white shadow-sm text-sm p-1.5 focus:border-blue-500 focus:ring-blue-500 cursor-pointer" %>
        <p class="text-[10px] text-blue-700 mt-1">Upload a quiz worksheet for students to download, print, write on, and submit.</p>
      </div>
    </div>

    <div class="border-t border-gray-100 pt-6">
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-lg font-bold text-gray-800">Quiz Questions</h2>
        <button type="button" data-action="click->nested-form#add" class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold text-white bg-blue-600 rounded-lg hover:bg-blue-700 shadow-sm transition duration-150 ease-in-out cursor-pointer">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
          </svg>
          Add Question
        </button>
      </div>

      <!-- Container for dynamic questions -->
      <div class="space-y-4" data-nested-form-target="container">
        <%= f.fields_for :quiz_questions do |q_form| %>
          <%= render "quiz_question_fields", q_form: q_form %>
        <% end %>
      </div>

      <!-- Template for new questions -->
      <template data-nested-form-target="template">
        <%= f.fields_for :quiz_questions, QuizQuestion.new, child_index: "NEW_RECORD" do |q_form| %>
          <%= render "quiz_question_fields", q_form: q_form %>
        <% end %>
      </template>
    </div>

    <div class="flex justify-end gap-3 border-t border-gray-100 pt-6">
      <%= link_to "Cancel", subject_path(@subject), class: "px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50" %>
      <%= f.submit "Create Quiz", class: "px-6 py-2.5 text-sm font-semibold text-white bg-blue-600 rounded-lg hover:bg-blue-700 shadow-sm cursor-pointer" %>
    </div>
  <% end %>
</div>
