<div class="max-w-3xl mx-auto px-4 py-6">
  <div class="mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <div>
      <%= link_to t("quizzes.show.back"), subject_path(@subject), class: "text-sm text-blue-600 hover:text-blue-800 font-medium" %>
      <h1 class="text-2xl font-bold mt-2 text-gray-900"><%= @quiz.title %></h1>
      <p class="text-sm text-gray-500"><%= t("quizzes.show.max_points", points: @quiz.total_points) %> &middot; <%= t("quizzes.show.due_prefix", date: l(@quiz.due_at, format: :long)) %></p>
    </div>
    
    <% if Current.user.teacher? || Current.user.admin? %>
      <div class="flex gap-2 flex-wrap sm:shrink-0">
        <%= link_to t("quizzes.show.grade_submissions_button"), grade_subject_quiz_path(@subject, @quiz), class: "rounded-lg bg-blue-600 px-4 py-2 text-sm font-semibold text-white hover:bg-blue-700 shadow-sm transition" %>
        <%= button_to @quiz.locked? ? t("quizzes.show.unlock_button") : t("quizzes.show.lock_button"), subject_quiz_path(@subject, @quiz), method: :patch, params: { quiz: { locked: !@quiz.locked? }, redirect_to: request.original_url }, class: "rounded-lg #{@quiz.locked? ? 'bg-green-50 text-green-600 hover:bg-green-100 border-green-200' : 'bg-amber-50 text-amber-600 hover:bg-amber-100 border-amber-200'} px-4 py-2 text-sm font-semibold border transition cursor-pointer" %>
        <% if !@quiz.locked? %>
          <% if @quiz.closed? %>
            <%= button_to t("quizzes.show.reopen_button"), subject_quiz_path(@subject, @quiz), method: :patch, params: { quiz: { closed: false }, redirect_to: request.original_url }, class: "rounded-lg bg-green-50 text-green-600 hover:bg-green-100 border border-green-200 px-4 py-2 text-sm font-semibold transition cursor-pointer" %>
          <% elsif !@quiz.ended? %>
            <%= button_to t("quizzes.show.end_button"), subject_quiz_path(@subject, @quiz), method: :patch, params: { quiz: { closed: true }, redirect_to: request.original_url }, data: { turbo_confirm: t("quizzes.show.confirm_end") }, class: "rounded-lg bg-red-50 text-red-600 hover:bg-red-100 border border-red-200 px-4 py-2 text-sm font-semibold transition cursor-pointer" %>
          <% end %>
        <% end %>
        <%= link_to t("quizzes.show.edit_button"), edit_subject_quiz_path(@subject, @quiz), class: "rounded-lg bg-gray-100 px-4 py-2 text-sm font-semibold text-gray-700 hover:bg-gray-200 transition" %>
        <%= button_to t("quizzes.show.delete_button"), subject_quiz_path(@subject, @quiz), method: :delete, data: { turbo_confirm: t("quizzes.show.confirm_delete") }, class: "rounded-lg bg-red-50 px-4 py-2 text-sm font-semibold text-red-600 hover:bg-red-100 transition cursor-pointer" %>
      </div>
    <% end %>
  </div>

  <% if Current.user.student? %>
    <%= turbo_stream_from "quiz_#{@quiz.id}_user_#{Current.user.id}" %>
    <% if @submitted %>
      <%= render partial: "quizzes/student_submission", locals: { quiz: @quiz, answers: @answers, questions: @questions } %>
    <% elsif @quiz.locked? %>
      <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-8 text-center">
        <svg class="w-12 h-12 text-amber-500 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
        </svg>
        <p class="text-gray-700 font-semibold"><%= t("quizzes.show.locked_title") %></p>
        <p class="text-sm text-gray-500 mt-1"><%= t("quizzes.show.locked_hint") %></p>
      </div>
    <% elsif @quiz.closed? %>
      <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-8 text-center">
        <svg class="w-12 h-12 text-orange-500 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"></path>
        </svg>
        <p class="text-gray-700 font-semibold"><%= t("quizzes.show.closed_title") %></p>
        <p class="text-sm text-gray-500 mt-1"><%= t("quizzes.show.closed_hint") %></p>
      </div>
    <% elsif @quiz.due_at < Time.current %>
      <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-8 text-center">
        <svg class="w-12 h-12 text-red-400 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
        </svg>
        <p class="text-gray-700 font-semibold"><%= t("quizzes.show.past_due_title") %></p>
        <p class="text-sm text-gray-500 mt-1"><%= t("quizzes.show.past_due_hint", date: l(@quiz.due_at, format: :long)) %></p>
      </div>
    <% else %>
      <%= form_with url: subject_quiz_quiz_answers_path(@subject, @quiz), method: :post, class: "bg-white rounded-xl border border-gray-200 shadow-sm p-6 space-y-6" do |f| %>
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-gray-100 pb-4" data-controller="countdown" data-countdown-due-at-value="<%= @quiz.due_at.iso8601 %>">
          <p class="text-sm text-gray-600"><%= t("quizzes.show.take_form_instruction") %></p>
          <div class="flex items-center gap-1.5 bg-red-50 text-red-700 px-3 py-1 rounded-lg border border-red-200 text-xs font-semibold self-start sm:self-auto">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <span data-countdown-target="timer">--:--:--</span>
          </div>
        </div>
        
        <div class="space-y-6">
          <% @questions.each_with_index do |q, idx| %>
            <div class="space-y-2">
              <div class="flex justify-between items-start">
                <label class="block text-sm font-semibold text-gray-800">
                  <%= t("quizzes.show.q_prefix", num: idx + 1) %>: <span class="font-normal text-gray-700"><%= q.question %></span>
                </label>
                <span class="text-xs text-gray-400 font-medium whitespace-nowrap"><%= t("quizzes.show.points_count", count: q.points) %></span>
              </div>
              
              <% if q.question_type == 'true_false' || q.question_type == 'mcq' %>
                <div class="space-y-2 mt-1">
                  <% (q.choices || [ t("quizzes.show.true_choice"), t("quizzes.show.false_choice") ]).each_with_index do |choice, c_idx| %>
                    <div class="flex items-center gap-2">
                      <%= radio_button_tag "answers[#{q.id}]", choice, false, id: "answers_#{q.id}_#{c_idx}", required: true, class: "h-4 w-4 text-blue-600 border-gray-300 focus:ring-blue-500" %>
                      <%= label_tag "answers_#{q.id}_#{c_idx}", choice, class: "text-sm text-gray-700 font-medium cursor-pointer" %>
                    </div>
                  <% end %>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>

        <div class="flex justify-end pt-4 border-t border-gray-100">
          <%= f.submit t("quizzes.show.submit_button"), class: "px-6 py-2.5 text-sm font-semibold text-white bg-blue-600 rounded-lg hover:bg-blue-700 shadow-sm cursor-pointer", data: { turbo_confirm: t("quizzes.show.confirm_submit") } %>
        </div>
      <% end %>
    <% end %>
  <% else %>
    <%# Teacher details view %>
    <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-6 space-y-6">
      <h2 class="text-lg font-bold text-gray-800 mb-2"><%= t("quizzes.show.details_title") %></h2>
      <div class="space-y-4">
        <% @questions.each_with_index do |q, idx| %>
          <div class="p-4 bg-gray-50 rounded-lg border border-gray-100 flex justify-between items-start gap-4">
            <div class="space-y-1">
              <p class="font-semibold text-xs text-gray-500 uppercase tracking-wide"><%= t("quizzes.show.q_prefix", num: idx + 1) %> (<%= q.question_type == "true_false" ? t("quizzes.fields.true_false") : t("quizzes.fields.mcq") %>)</p>
              <p class="text-sm text-gray-800 mt-1 font-medium"><%= q.question %></p>
              
              <% if (q.question_type == 'mcq' || q.question_type == 'true_false') && q.choices.present? %>
                <div class="mt-2 ps-4 border-s-2 border-gray-200 space-y-1">
                  <% q.choices.each do |choice| %>
                    <p class="text-xs text-gray-600 font-medium">• <%= choice %></p>
                  <% end %>
                </div>
              <% end %>
            </div>
            <span class="text-xs font-bold text-gray-500 whitespace-nowrap bg-white px-2.5 py-1 rounded border border-gray-200 shadow-sm"><%= q.points %> <%= t("quizzes.show.pts") %></span>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
