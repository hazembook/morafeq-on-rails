<div class="max-w-3xl mx-auto px-4 py-6">
  <div class="mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <div>
      <%= link_to "← Back to Subject", subject_path(@subject), class: "text-sm text-blue-600 hover:text-blue-800 font-medium" %>
      <h1 class="text-2xl font-bold mt-2 text-gray-900"><%= @quiz.title %></h1>
      <p class="text-sm text-gray-500">Max Points: <%= @quiz.total_points %> &middot; Due: <%= @quiz.due_at.strftime("%B %d, %Y at %I:%M %p") %></p>
    </div>
    
    <% if Current.user.teacher? || Current.user.admin? %>
      <div>
        <%= link_to "Grade Submissions", grade_subject_quiz_path(@subject, @quiz), class: "rounded-lg bg-blue-600 px-4 py-2 text-sm font-semibold text-white hover:bg-blue-700 shadow-sm" %>
      </div>
    <% end %>
  </div>

  <% if @quiz.quiz_file.attached? %>
    <div class="mb-6 bg-blue-50 border border-blue-200 rounded-xl p-4 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
      <div class="flex items-center gap-3">
        <svg class="w-10 h-10 text-blue-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
        </svg>
        <div>
          <h3 class="text-sm font-semibold text-blue-900">Quiz Worksheet Attached</h3>
          <p class="text-xs text-blue-700">You can download this worksheet, print it, write your answers, and upload a scan of your completed sheet.</p>
        </div>
      </div>
      <%= link_to "Download Worksheet", rails_blob_path(@quiz.quiz_file, disposition: "attachment"), class: "inline-flex items-center gap-2 px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-xs font-semibold rounded-lg shadow-sm shrink-0", target: "_blank" %>
    </div>
  <% end %>

  <% if Current.user.student? %>
    <% if @submitted %>
      <!-- Submissions Display -->
      <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-6 space-y-6">
        <div class="p-4 bg-green-50 border border-green-200 rounded-lg flex items-center justify-between">
          <div>
            <p class="text-sm font-semibold text-green-800">Quiz Completed</p>
            <p class="text-xs text-green-600">Your answers were successfully submitted.</p>
          </div>
          <div class="text-right">
            <% total_score = @answers.map(&:score).compact.sum %>
            <% all_graded = @answers.all? { |a| a.score.present? } %>
            <% if all_graded %>
              <span class="text-lg font-bold text-green-700"><%= total_score %> / <%= @quiz.total_points %> pts</span>
            <% else %>
              <span class="text-sm font-semibold text-orange-600">Pending Grade</span>
            <% end %>
          </div>
        </div>

        <div class="space-y-4">
          <% @questions.each_with_index do |q, idx| %>
            <% ans = @answers.find { |a| a.quiz_question_id == q.id } %>
            <div class="p-4 bg-gray-50 rounded-lg border border-gray-100 space-y-2">
              <div class="flex justify-between items-start gap-4">
                <div>
                  <p class="font-medium text-sm text-gray-800">Q<%= idx + 1 %>: <%= q.question %></p>
                  <p class="text-xs text-gray-500 font-medium">Type: <%= q.question_type.titleize %></p>
                </div>
                <span class="text-xs font-semibold text-gray-500 whitespace-nowrap"><%= ans&.score || "-" %> / <%= q.points %> pts</span>
              </div>
              <div class="bg-white p-3 rounded border border-gray-200 text-sm text-gray-700">
                <%= format_quiz_answer(ans) %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    <% elsif @quiz.due_at < Time.current %>
      <!-- Past Due Display -->
      <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-8 text-center">
        <svg class="w-12 h-12 text-red-400 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
        </svg>
        <p class="text-gray-700 font-semibold">Quiz Past Due</p>
        <p class="text-sm text-gray-500 mt-1">This quiz was due on <%= @quiz.due_at.strftime("%B %d, %Y at %I:%M %p") %> and is no longer accepting answers.</p>
      </div>
    <% else %>
      <!-- Take Quiz Form -->
      <%= form_with url: subject_quiz_quiz_answers_path(@subject, @quiz), method: :post, multipart: true, class: "bg-white rounded-xl border border-gray-200 shadow-sm p-6 space-y-6" do |f| %>
        <p class="text-sm text-gray-600 border-b border-gray-100 pb-4">Please answer each question carefully.</p>
        
        <div class="space-y-6">
          <% @questions.each_with_index do |q, idx| %>
            <div class="space-y-2">
              <div class="flex justify-between items-start">
                <label class="block text-sm font-semibold text-gray-800">
                  Question <%= idx + 1 %>: <span class="font-normal text-gray-700"><%= q.question %></span>
                </label>
                <span class="text-xs text-gray-400 font-medium whitespace-nowrap"><%= q.points %> points</span>
              </div>
              
              <% if q.question_type == 'written' %>
                <div class="space-y-3">
                  <div>
                    <label class="block text-xs font-semibold text-gray-500 uppercase mb-1">Type Answer</label>
                    <%= text_area_tag "answers[#{q.id}][text]", "", rows: 3, placeholder: "Type your answer here...", class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm" %>
                  </div>
                  <div class="bg-gray-50 p-3 rounded-lg border border-dashed border-gray-300">
                    <label class="block text-xs font-semibold text-gray-600 uppercase mb-1">Or Upload Written Answer File (PDF/Image)</label>
                    <%= file_field_tag "answers[#{q.id}][file]", class: "block w-full text-sm text-gray-500 file:mr-4 file:py-1.5 file:px-3 file:rounded-md file:border-0 file:text-xs file:font-semibold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100 cursor-pointer" %>
                    <p class="text-[10px] text-gray-500 mt-1">If you printed the worksheet, scanned it or took a photo, upload it here.</p>
                  </div>
                </div>
              
              <% elsif q.question_type == 'true_false' %>
                <div class="space-y-2 mt-1">
                  <div class="flex items-center gap-2">
                    <%= radio_button_tag "answers[#{q.id}]", "True", false, id: "answers_#{q.id}_true", required: true, class: "h-4 w-4 text-blue-600 border-gray-300 focus:ring-blue-500" %>
                    <%= label_tag "answers_#{q.id}_true", "True", class: "text-sm text-gray-700 font-medium cursor-pointer" %>
                  </div>
                  <div class="flex items-center gap-2">
                    <%= radio_button_tag "answers[#{q.id}]", "False", false, id: "answers_#{q.id}_false", required: true, class: "h-4 w-4 text-blue-600 border-gray-300 focus:ring-blue-500" %>
                    <%= label_tag "answers_#{q.id}_false", "False", class: "text-sm text-gray-700 font-medium cursor-pointer" %>
                  </div>
                </div>
              
              <% elsif q.question_type == 'mcq' %>
                <div class="space-y-2 mt-1">
                  <% (q.choices || []).each_with_index do |choice, c_idx| %>
                    <div class="flex items-center gap-2">
                      <%= radio_button_tag "answers[#{q.id}]", choice, false, id: "answers_#{q.id}_#{c_idx}", required: true, class: "h-4 w-4 text-blue-600 border-gray-300 focus:ring-blue-500" %>
                      <%= label_tag "answers_#{q.id}_#{c_idx}", choice, class: "text-sm text-gray-700 font-medium cursor-pointer" %>
                    </div>
                  <% end %>
                </div>
              
              <% elsif q.question_type == 'match' %>
                <div class="space-y-3 mt-2 bg-gray-50 p-3 rounded-lg border border-gray-200">
                  <p class="text-xs text-gray-500 mb-2 font-medium">Match each left item with its correct counterpart from the dropdown:</p>
                  <% shuffled_values = (q.choices || {}).values.shuffle %>
                  <% (q.choices || {}).keys.each_with_index do |left, k_idx| %>
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-gray-100 pb-2 last:border-0 last:pb-0">
                      <span class="text-sm text-gray-700 font-medium sm:w-1/2"><%= left %></span>
                      <%= select_tag "answers[#{q.id}][#{left}]", options_for_select([["Select match...", ""]] + shuffled_values.map { |v| [v, v] }), required: true, class: "sm:w-1/2 rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm py-1" %>
                    </div>
                  <% end %>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>

        <div class="flex justify-end pt-4 border-t border-gray-100">
          <%= f.submit "Submit Answers", class: "px-6 py-2.5 text-sm font-semibold text-white bg-blue-600 rounded-lg hover:bg-blue-700 shadow-sm cursor-pointer", data: { turbo_confirm: "Are you sure you want to submit? You cannot edit your answers after submitting." } %>
        </div>
      <% end %>
    <% end %>
  <% else %>
    <!-- Teacher Details View -->
    <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-6 space-y-6">
      <h2 class="text-lg font-bold text-gray-800 mb-2">Quiz Questions & Details</h2>
      <div class="space-y-4">
        <% @questions.each_with_index do |q, idx| %>
          <div class="p-4 bg-gray-50 rounded-lg border border-gray-100 flex justify-between items-start gap-4">
            <div class="space-y-1">
              <p class="font-semibold text-xs text-gray-500 uppercase tracking-wide">Question <%= idx + 1 %> (<%= q.question_type.titleize %>)</p>
              <p class="text-sm text-gray-800 mt-1 font-medium"><%= q.question %></p>
              
              <% if q.question_type == 'mcq' && q.choices.present? %>
                <div class="mt-2 pl-4 border-l-2 border-gray-200 space-y-1">
                  <% q.choices.each do |choice| %>
                    <p class="text-xs text-gray-600 font-medium">• <%= choice %></p>
                  <% end %>
                </div>
              <% elsif q.question_type == 'match' && q.choices.present? %>
                <div class="mt-2 pl-4 border-l-2 border-gray-200 space-y-1">
                  <% q.choices.each do |k, v| %>
                    <p class="text-xs text-gray-600"><span class="font-semibold text-gray-700"><%= k %></span> → <span class="text-blue-600 font-medium"><%= v %></span></p>
                  <% end %>
                </div>
              <% elsif q.question_type == 'true_false' %>
                <p class="text-xs text-gray-500 mt-1 italic">Options: True, False</p>
              <% end %>
            </div>
            <span class="text-xs font-bold text-gray-500 whitespace-nowrap bg-white px-2.5 py-1 rounded border border-gray-200 shadow-sm"><%= q.points %> pts</span>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
