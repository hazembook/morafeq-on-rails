<div class="max-w-4xl mx-auto px-4 py-6">
  <div class="mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <div>
      <%= link_to t("quizzes.index.back"), subject_path(@subject), class: "text-sm text-blue-600 hover:text-blue-800 font-medium" %>
      <h1 class="text-2xl font-bold mt-2 text-gray-900"><%= t("quizzes.index.title") %></h1>
      <p class="text-sm text-gray-500"><%= t("quizzes.index.subtitle", name: @subject.name, code: @subject.code) %></p>
    </div>
    
    <% if Current.user.teacher? || Current.user.admin? %>
      <div>
        <%= link_to t("quizzes.index.create_button"), new_subject_quiz_path(@subject), class: "rounded-lg bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-blue-700 shadow-sm transition duration-150 inline-block text-center cursor-pointer" %>
      </div>
    <% end %>
  </div>

  <% if @quizzes.any? %>
    <div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
      <div class="divide-y divide-gray-100">
        <% @quizzes.each do |quiz| %>
          <div class="p-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 hover:bg-gray-50 transition-colors">
            <div class="min-w-0 flex-1">
              <%= link_to quiz.title, subject_quiz_path(@subject, quiz), class: "font-bold text-base text-gray-900 hover:text-blue-600 block truncate" %>
              <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-gray-500 mt-1">
                <span><%= t("quizzes.index.due_prefix", date: l(quiz.due_at, format: :long)) %></span>
                <span class="text-gray-300">•</span>
                <span><%= t("quizzes.index.max_points", points: quiz.total_points) %></span>
                <span class="text-gray-300">•</span>
                <span><%= t("quizzes.index.questions_count", count: quiz.quiz_questions.count) %></span>
                <span class="text-gray-300">•</span>
                <% if quiz.locked? %>
                  <span class="inline-flex items-center rounded bg-red-50 px-1.5 py-0.5 text-[10px] font-medium text-red-700 ring-1 ring-inset ring-red-600/10"><%= t("quizzes.states.locked") %></span>
                <% elsif quiz.closed? %>
                  <span class="inline-flex items-center rounded bg-orange-50 px-1.5 py-0.5 text-[10px] font-medium text-orange-700 ring-1 ring-inset ring-orange-600/10"><%= t("quizzes.states.closed") %></span>
                <% elsif quiz.ended? %>
                  <span class="inline-flex items-center rounded bg-gray-50 px-1.5 py-0.5 text-[10px] font-medium text-gray-600 ring-1 ring-inset ring-gray-500/10"><%= t("quizzes.states.ended") %></span>
                <% else %>
                  <span class="inline-flex items-center rounded bg-green-50 px-1.5 py-0.5 text-[10px] font-medium text-green-700 ring-1 ring-inset ring-green-600/20"><%= t("quizzes.states.open") %></span>
                <% end %>
              </div>
            </div>

            <div class="flex items-center gap-2 shrink-0 self-end sm:self-auto">
              <% if Current.user.student? %>
                <% ans = QuizAnswer.joins(:quiz_question).where(quiz_questions: { quiz_id: quiz.id }, user_id: Current.user.id) %>
                <% if ans.any? %>
                  <% total_score = ans.map(&:score).compact.sum %>
                  <% all_graded = ans.all? { |a| a.score.present? } %>
                  <span class="text-xs font-semibold px-2.5 py-1 rounded-full <%= all_graded ? 'bg-green-100 text-green-800 border border-green-200' : 'bg-yellow-100 text-yellow-800 border border-yellow-200' %>">
                    <%= all_graded ? t("quizzes.index.completed_points", score: total_score, total: quiz.total_points) : t("quizzes.index.pending_grade") %>
                  </span>
                <% else %>
                  <%= link_to t("quizzes.index.take_button"), subject_quiz_path(@subject, quiz), class: "rounded-lg bg-blue-50 px-4 py-2 text-xs font-semibold text-blue-600 hover:bg-blue-100 border border-blue-200 transition" %>
                <% end %>
              <% else %>
                <%= link_to t("quizzes.index.grade_button"), grade_subject_quiz_path(@subject, quiz), class: "rounded-lg bg-blue-50 px-3 py-1.5 text-xs font-semibold text-blue-600 hover:bg-blue-100 border border-blue-200 transition" %>
                <%= button_to quiz.locked? ? t("quizzes.index.unlock_button") : t("quizzes.index.lock_button"), subject_quiz_path(@subject, quiz), method: :patch, params: { quiz: { locked: !quiz.locked? }, redirect_to: request.original_url }, class: "rounded-lg #{quiz.locked? ? 'bg-green-50 text-green-600 hover:bg-green-100 border-green-200' : 'bg-amber-50 text-amber-600 hover:bg-amber-100 border-amber-200'} px-3 py-1.5 text-xs font-semibold border transition cursor-pointer" %>
                <% if !quiz.locked? %>
                  <% if quiz.closed? %>
                    <%= button_to t("quizzes.index.reopen_button"), subject_quiz_path(@subject, quiz), method: :patch, params: { quiz: { closed: false }, redirect_to: request.original_url }, class: "rounded-lg bg-green-50 text-green-600 hover:bg-green-100 border border-green-200 px-3 py-1.5 text-xs font-semibold transition cursor-pointer" %>
                  <% elsif !quiz.ended? %>
                    <%= button_to t("quizzes.index.end_button"), subject_quiz_path(@subject, quiz), method: :patch, params: { quiz: { closed: true }, redirect_to: request.original_url }, data: { turbo_confirm: t("quizzes.index.confirm_end") }, class: "rounded-lg bg-red-50 text-red-600 hover:bg-red-100 border border-red-200 px-3 py-1.5 text-xs font-semibold transition cursor-pointer" %>
                  <% end %>
                <% end %>
                <%= link_to t("common.edit"), edit_subject_quiz_path(@subject, quiz), class: "rounded-lg bg-gray-100 px-3 py-1.5 text-xs font-semibold text-gray-700 hover:bg-gray-200 transition" %>
                <%= button_to t("common.delete"), subject_quiz_path(@subject, quiz), method: :delete, data: { turbo_confirm: t("quizzes.index.confirm_delete") }, class: "rounded-lg bg-red-50 px-3 py-1.5 text-xs font-semibold text-red-600 hover:bg-red-100 border border-red-100 transition cursor-pointer" %>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% else %>
    <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-12 text-center">
      <svg class="w-12 h-12 text-gray-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"></path>
      </svg>
      <p class="text-gray-700 font-semibold"><%= t("quizzes.index.no_quizzes_title") %></p>
      <p class="text-sm text-gray-400 mt-1"><%= t("quizzes.index.no_quizzes_hint") %></p>
    </div>
  <% end %>
</div>
