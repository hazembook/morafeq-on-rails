<div id="quiz_submission_status" class="bg-white rounded-xl border border-gray-200 shadow-sm p-6 space-y-6">
  <div class="p-4 bg-green-50 border border-green-200 rounded-lg flex items-center justify-between">
    <div>
      <p class="text-sm font-semibold text-green-800"><%= t("quizzes.show.completed_title") %></p>
      <p class="text-xs text-green-600"><%= t("quizzes.show.completed_hint") %></p>
    </div>
    <div class="text-right">
      <% total_score = answers.map(&:score).compact.sum %>
      <% all_graded = answers.all? { |a| a.score.present? } %>
      <% if all_graded %>
        <span class="text-lg font-bold text-green-700"><%= total_score %> / <%= quiz.total_points %> <%= t("quizzes.show.pts") %></span>
      <% else %>
        <span class="text-sm font-semibold text-orange-600"><%= t("quizzes.show.pending_grade") %></span>
      <% end %>
    </div>
  </div>

  <div class="space-y-4">
    <% questions.each_with_index do |q, idx| %>
      <% ans = answers.find { |a| a.quiz_question_id == q.id } %>
      <div class="p-4 bg-gray-50 rounded-lg border border-gray-100 space-y-2">
        <div class="flex justify-between items-start gap-4">
          <div>
            <p class="font-medium text-sm text-gray-800"><%= t("quizzes.show.q_prefix", num: idx + 1) %>: <%= q.question %></p>
            <p class="text-xs text-gray-500 font-medium"><%= t("quizzes.show.type_prefix", type: q.question_type == "true_false" ? t("quizzes.fields.true_false") : t("quizzes.fields.mcq")) %></p>
          </div>
          <span class="text-xs font-semibold text-gray-500 whitespace-nowrap"><%= ans&.score || "-" %> / <%= q.points %> <%= t("quizzes.show.pts") %></span>
        </div>
        <div class="bg-white p-3 rounded border border-gray-200 text-sm text-gray-700">
          <%= format_quiz_answer(ans) %>
        </div>
      </div>
    <% end %>
  </div>
</div>
