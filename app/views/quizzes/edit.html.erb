<div class="max-w-2xl mx-auto px-4 py-6">
  <div class="mb-6">
    <%= link_to t("quizzes.edit.back"), subject_quiz_path(@subject, @quiz), class: "text-sm text-blue-600 hover:text-blue-800" %>
    <h1 class="text-2xl font-bold mt-2 text-gray-900"><%= t("quizzes.edit.title") %></h1>
    <p class="text-sm text-gray-500"><%= @subject.name %> (<%= @subject.code %>)</p>
  </div>

  <%= form_with model: [ @subject, @quiz ], data: { controller: "nested-form" }, class: "bg-white rounded-xl border border-gray-200 shadow-sm p-6 space-y-6" do |f| %>
    <% if @quiz.errors.any? %>
      <div class="bg-red-50 text-red-700 p-4 rounded-lg text-sm border border-red-200">
        <h3 class="font-semibold mb-1"><%= t("quizzes.new.errors_title") %></h3>
        <ul class="list-disc list-inside">
          <% @quiz.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <%= f.label :title, t("quizzes.new.title_label"), class: "block text-sm font-semibold text-gray-700 mb-1" %>
      <%= f.text_field :title, placeholder: t("quizzes.new.title_placeholder"), required: true, class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm" %>
    </div>

    <div>
      <%= f.label :due_at, t("quizzes.new.due_label"), class: "block text-sm font-semibold text-gray-700 mb-1" %>
      <%= f.datetime_local_field :due_at, required: true, class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm" %>
    </div>

    <div class="flex items-center gap-2">
      <%= f.check_box :locked, class: "h-4 w-4 rounded border-gray-300 text-blue-600 focus:ring-blue-500" %>
      <%= f.label :locked, t("quizzes.edit.lock_label"), class: "text-sm text-gray-700 font-semibold cursor-pointer" %>
    </div>

    <div class="border-t border-gray-100 pt-6">
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-lg font-bold text-gray-800"><%= t("quizzes.new.questions_heading") %></h2>
        <button type="button" data-action="click->nested-form#add" class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold text-white bg-blue-600 rounded-lg hover:bg-blue-700 shadow-sm transition duration-150 ease-in-out cursor-pointer">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
          </svg>
          <%= t("quizzes.new.add_question_button") %>
        </button>
      </div>

      <!-- Container for dynamic questions -->
      <div class="space-y-4" data-nested-form-target="container">
        <%= f.fields_for :quiz_questions do |q_form| %>
          <%= render "quiz_question_fields", q_form: q_form %>
        <% end %>
      </div>

      <!-- Template for new questions -->
      <template data-nested-form-target="template">
        <%= f.fields_for :quiz_questions, QuizQuestion.new, child_index: "NEW_RECORD" do |q_form| %>
          <%= render "quiz_question_fields", q_form: q_form %>
        <% end %>
      </template>
    </div>

    <div class="flex justify-end gap-3 border-t border-gray-100 pt-6">
      <%= link_to t("common.cancel"), subject_quiz_path(@subject, @quiz), class: "px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50" %>
      <%= f.submit t("quizzes.edit.update_button"), class: "px-6 py-2.5 text-sm font-semibold text-white bg-blue-600 rounded-lg hover:bg-blue-700 shadow-sm cursor-pointer" %>
    </div>
  <% end %>
</div>
