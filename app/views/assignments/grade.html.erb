<div class="max-w-4xl mx-auto px-4 py-6">
  <div class="mb-6">
    <%= link_to t("assignments.grade.back"), subject_assignment_path(@subject, @assignment), class: "text-sm text-blue-600 hover:text-blue-800" %>
    <h1 class="text-2xl font-bold mt-2 text-gray-900"><%= t("assignments.grade.title") %></h1>
    <p class="text-sm text-gray-500"><%= t("assignments.grade.subtitle", title: @assignment.title, points: @assignment.total_points) %></p>
  </div>

  <% if @submissions.any? %>
    <%= form_with url: grade_submissions_subject_assignment_path(@subject, @assignment), method: :post, class: "space-y-8" do |f| %>
      <% @submissions.each do |submission| %>
        <div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
          <div class="bg-gray-50 px-6 py-4 border-b border-gray-100 flex items-center justify-between">
            <div>
              <h2 class="font-bold text-gray-900"><%= submission.user.full_name %></h2>
              <p class="text-xs text-gray-500"><%= t("assignments.grade.submitted_ago", time: time_ago_in_words(submission.created_at)) %></p>
            </div>
            <div class="text-right">
              <span class="text-xs font-semibold px-2.5 py-1 rounded-full <%= submission.score.present? ? "bg-green-100 text-green-800" : "bg-yellow-100 text-yellow-800" %>">
                <%= submission.score.present? ? t("assignments.grade.status_graded", score: submission.score, total: @assignment.total_points) : t("assignments.grade.status_ungraded") %>
              </span>
            </div>
          </div>

          <div class="p-6 space-y-4">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-gray-50 p-4 rounded-lg border border-gray-100">
              <div class="flex items-center gap-2">
                <svg class="w-5 h-5 text-gray-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                </svg>
                <%= link_to t("assignments.grade.download_file", filename: submission.file.filename), rails_blob_path(submission.file, disposition: "attachment"), class: "text-sm font-semibold text-blue-600 hover:text-blue-800 underline", target: "_blank" %>
              </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
              <div class="md:col-span-1">
                <label class="block text-xs font-semibold text-gray-500 uppercase mb-1"><%= t("assignments.grade.score_label") %></label>
                <div class="flex items-center gap-2">
                  <%= number_field_tag "grades[#{submission.id}]", submission.score, min: 0, max: @assignment.total_points, step: 1, required: true, class: "w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm py-1.5" %>
                  <span class="text-xs text-gray-500 shrink-0">/ <%= @assignment.total_points %> <%= t("assignments.grade.pts") %></span>
                </div>
              </div>
              <div class="md:col-span-2">
                <label class="block text-xs font-semibold text-gray-500 uppercase mb-1"><%= t("assignments.grade.feedback_label") %></label>
                <%= text_field_tag "feedbacks[#{submission.id}]", submission.feedback, placeholder: t("assignments.grade.feedback_placeholder"), class: "w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm py-1.5" %>
              </div>
            </div>
          </div>
        </div>
      <% end %>

      <div class="flex justify-end gap-3 pt-4">
        <%= link_to t("common.cancel"), subject_assignment_path(@subject, @assignment), class: "px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50" %>
        <%= f.submit t("assignments.grade.save_button"), class: "px-6 py-2 text-sm font-semibold text-white bg-blue-600 rounded-lg hover:bg-blue-700 shadow-sm cursor-pointer" %>
      </div>
    <% end %>
  <% else %>
    <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-12 text-center">
      <svg class="w-12 h-12 text-gray-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"></path>
      </svg>
      <p class="text-gray-700 font-semibold"><%= t("assignments.grade.no_submissions_title") %></p>
      <p class="text-sm text-gray-400 mt-1"><%= t("assignments.grade.no_submissions_hint") %></p>
    </div>
  <% end %>
</div>
