<div id="student_submission_status" class="bg-white rounded-xl border border-gray-200 shadow-sm p-6 space-y-6">
  <div class="p-4 bg-green-50 border border-green-200 rounded-lg flex items-center justify-between">
    <div>
      <p class="text-sm font-semibold text-green-800"><%= t("assignments.show.submitted_title") %></p>
      <p class="text-xs text-green-600"><%= t("assignments.show.submitted_hint") %></p>
    </div>
    <div class="text-end">
      <% if submission.score.present? %>
        <span class="text-lg font-bold text-green-700"><%= submission.score %> / <%= assignment.total_points %> <%= t("assignments.show.pts") %></span>
      <% else %>
        <span class="text-sm font-semibold text-orange-600"><%= t("assignments.show.pending_grade") %></span>
      <% end %>
    </div>
  </div>

  <div class="space-y-4">
    <h3 class="text-sm font-bold text-gray-800"><%= t("assignments.show.your_submission_heading") %></h3>
    <div class="p-4 bg-gray-50 rounded-lg border border-gray-100 space-y-3">
      <div class="flex items-center gap-2">
        <svg class="w-5 h-5 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
        </svg>
        <%= link_to t("assignments.show.download_solved", filename: submission.file.filename), rails_blob_path(submission.file, disposition: "attachment"), class: "text-sm font-semibold text-blue-600 hover:text-blue-800 underline", target: "_blank" %>
      </div>
      <p class="text-xs text-gray-400" data-controller="timeago" data-timeago-datetime-value="<%= submission.created_at.iso8601 %>" data-timeago-format-value="<%= t("assignments.show.uploaded_ago", time: "%{time}") %>"><%= t("assignments.show.uploaded_ago", time: time_ago_in_words(submission.created_at)) %></p>
    </div>

    <% if submission.feedback.present? %>
      <div class="p-4 bg-blue-50/50 rounded-lg border border-blue-100">
        <h4 class="text-xs font-bold text-blue-900 uppercase"><%= t("assignments.show.feedback_heading") %></h4>
        <p class="text-sm text-gray-700 mt-1 whitespace-pre-wrap"><%= submission.feedback %></p>
      </div>
    <% end %>
  </div>
</div>
