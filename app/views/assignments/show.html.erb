<div class="max-w-3xl mx-auto px-4 py-6">
  <div class="mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <div>
      <%= link_to "← Back to Subject", subject_path(@subject), class: "text-sm text-blue-600 hover:text-blue-800 font-medium" %>
      <h1 class="text-2xl font-bold mt-2 text-gray-900"><%= @assignment.title %></h1>
      <p class="text-sm text-gray-500">Max Points: <%= @assignment.total_points %> &middot; Due: <%= @assignment.due_at.strftime("%B %d, %Y at %I:%M %p") %></p>
    </div>
    
    <% if Current.user.teacher? || Current.user.admin? %>
      <div class="flex gap-2 flex-wrap sm:shrink-0">
        <%= link_to "Grade Submissions", grade_subject_assignment_path(@subject, @assignment), class: "rounded-lg bg-blue-600 px-4 py-2 text-sm font-semibold text-white hover:bg-blue-700 shadow-sm transition" %>
        <%= link_to "Edit Assignment", edit_subject_assignment_path(@subject, @assignment), class: "rounded-lg bg-gray-100 px-4 py-2 text-sm font-semibold text-gray-700 hover:bg-gray-200 transition" %>
        <%= button_to "Delete Assignment", subject_assignment_path(@subject, @assignment), method: :delete, data: { turbo_confirm: "Are you sure you want to delete this assignment?" }, class: "rounded-lg bg-red-50 px-4 py-2 text-sm font-semibold text-red-600 hover:bg-red-100 transition cursor-pointer" %>
      </div>
    <% end %>
  </div>

  <!-- Instruction Details Card -->
  <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-6 mb-6 space-y-4">
    <div>
      <h2 class="text-sm font-bold text-gray-400 uppercase tracking-wide">Instructions</h2>
      <p class="text-sm text-gray-700 mt-1 whitespace-pre-wrap"><%= @assignment.description.presence || "No instructions provided." %></p>
    </div>

    <% if @assignment.file.attached? %>
      <div class="bg-blue-50 border border-blue-200 rounded-xl p-4 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div class="flex items-center gap-3">
          <svg class="w-10 h-10 text-blue-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
          </svg>
          <div>
            <h3 class="text-sm font-semibold text-blue-900">Worksheet / Reference Document</h3>
            <p class="text-xs text-blue-700">Download this worksheet to view questions and instructions.</p>
          </div>
        </div>
        <%= link_to "Download Worksheet", rails_blob_path(@assignment.file, disposition: "attachment"), class: "inline-flex items-center gap-2 px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-xs font-semibold rounded-lg shadow-sm shrink-0", target: "_blank" %>
      </div>
    <% end %>
  </div>

  <% if Current.user.student? %>
    <% if @submitted %>
      <!-- Submissions Display -->
      <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-6 space-y-6">
        <div class="p-4 bg-green-50 border border-green-200 rounded-lg flex items-center justify-between">
          <div>
            <p class="text-sm font-semibold text-green-800">Assignment Submitted</p>
            <p class="text-xs text-green-600">Your solution file was successfully uploaded.</p>
          </div>
          <div class="text-right">
            <% if @submission.score.present? %>
              <span class="text-lg font-bold text-green-700"><%= @submission.score %> / <%= @assignment.total_points %> pts</span>
            <% else %>
              <span class="text-sm font-semibold text-orange-600">Pending Grade</span>
            <% end %>
          </div>
        </div>

        <div class="space-y-4">
          <h3 class="text-sm font-bold text-gray-800">Your Submission</h3>
          <div class="p-4 bg-gray-50 rounded-lg border border-gray-100 space-y-3">
            <div class="flex items-center gap-2">
              <svg class="w-5 h-5 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
              </svg>
              <%= link_to "Download Solved File (#{@submission.file.filename})", rails_blob_path(@submission.file, disposition: "attachment"), class: "text-sm font-semibold text-blue-600 hover:text-blue-800 underline", target: "_blank" %>
            </div>
            <p class="text-xs text-gray-400">Uploaded <%= time_ago_in_words(@submission.created_at) %> ago</p>
          </div>

          <% if @submission.feedback.present? %>
            <div class="p-4 bg-blue-50/50 rounded-lg border border-blue-100">
              <h4 class="text-xs font-bold text-blue-900 uppercase">Instructor Feedback</h4>
              <p class="text-sm text-gray-700 mt-1 whitespace-pre-wrap"><%= @submission.feedback %></p>
            </div>
          <% end %>
        </div>
      </div>
    <% elsif @assignment.due_at < Time.current %>
      <!-- Past Due Display -->
      <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-8 text-center">
        <svg class="w-12 h-12 text-red-400 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
        </svg>
        <p class="text-gray-700 font-semibold">Assignment Past Due</p>
        <p class="text-sm text-gray-500 mt-1">This assignment was due on <%= @assignment.due_at.strftime("%B %d, %Y at %I:%M %p") %> and is no longer accepting submissions.</p>
      </div>
    <% else %>
      <!-- Submit Solution Form -->
      <%= form_with model: [@subject, @assignment, @new_submission], class: "bg-white rounded-xl border border-gray-200 shadow-sm p-6 space-y-6" do |f| %>
        <p class="text-sm text-gray-600 border-b border-gray-100 pb-4">Please upload your solved document to submit this assignment.</p>
        
        <div class="space-y-4">
          <div class="bg-gray-50 p-6 rounded-xl border-2 border-dashed border-gray-300 text-center">
            <svg class="w-8 h-8 text-gray-400 mx-auto mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"></path>
            </svg>
            <%= f.file_field :file, required: true, class: "block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-md file:border-0 file:text-xs file:font-semibold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100 cursor-pointer" %>
            <p class="text-xxs text-gray-400 mt-2">Accepted formats: PDF, Word, PowerPoint, or images (Max 50MB).</p>
          </div>
        </div>

        <div class="flex justify-end pt-4 border-t border-gray-100">
          <%= f.submit "Submit Assignment", class: "px-6 py-2.5 text-sm font-semibold text-white bg-blue-600 rounded-lg hover:bg-blue-700 shadow-sm cursor-pointer", data: { turbo_confirm: "Are you sure you want to submit? You cannot replace your file after submitting." } %>
        </div>
      <% end %>
    <% end %>
  <% end %>
</div>
