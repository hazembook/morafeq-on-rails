<div class="max-w-3xl mx-auto px-4 py-6">
  <div class="mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <div>
      <%= link_to t("assignments.show.back"), subject_path(@subject), class: "text-sm text-blue-600 hover:text-blue-800 font-medium" %>
      <h1 class="text-2xl font-bold mt-2 text-gray-900"><%= @assignment.title %></h1>
      <p class="text-sm text-gray-500"><%= t("assignments.show.max_points", points: @assignment.total_points) %> &middot; <%= t("assignments.show.due_prefix", date: l(@assignment.due_at, format: :long)) %></p>
    </div>
    
    <% if Current.user.teacher? || Current.user.admin? %>
      <div class="flex gap-2 flex-wrap sm:shrink-0">
        <%= link_to t("assignments.show.grade_submissions_button"), grade_subject_assignment_path(@subject, @assignment), class: "rounded-lg bg-blue-600 px-4 py-2 text-sm font-semibold text-white hover:bg-blue-700 shadow-sm transition" %>
        <%= button_to @assignment.locked? ? t("assignments.show.unlock_button") : t("assignments.show.lock_button"), subject_assignment_path(@subject, @assignment), method: :patch, params: { assignment: { locked: !@assignment.locked? }, redirect_to: request.original_url }, class: "rounded-lg #{@assignment.locked? ? 'bg-green-50 text-green-600 hover:bg-green-100 border-green-200' : 'bg-amber-50 text-amber-600 hover:bg-amber-100 border-amber-200'} px-4 py-2 text-sm font-semibold border transition cursor-pointer" %>
        <% if !@assignment.locked? %>
          <% if @assignment.closed? %>
            <%= button_to t("assignments.show.reopen_button"), subject_assignment_path(@subject, @assignment), method: :patch, params: { assignment: { closed: false }, redirect_to: request.original_url }, class: "rounded-lg bg-green-50 text-green-600 hover:bg-green-100 border border-green-200 px-4 py-2 text-sm font-semibold transition cursor-pointer" %>
          <% elsif !@assignment.ended? %>
            <%= button_to t("assignments.show.end_button"), subject_assignment_path(@subject, @assignment), method: :patch, params: { assignment: { closed: true }, redirect_to: request.original_url }, data: { turbo_confirm: t("assignments.show.confirm_end") }, class: "rounded-lg bg-red-50 text-red-600 hover:bg-red-100 border border-red-200 px-4 py-2 text-sm font-semibold transition cursor-pointer" %>
          <% end %>
        <% end %>
        <%= link_to t("assignments.show.edit_button"), edit_subject_assignment_path(@subject, @assignment), class: "rounded-lg bg-gray-100 px-4 py-2 text-sm font-semibold text-gray-700 hover:bg-gray-200 transition" %>
        <%= button_to t("assignments.show.delete_button"), subject_assignment_path(@subject, @assignment), method: :delete, data: { turbo_confirm: t("assignments.show.confirm_delete") }, class: "rounded-lg bg-red-50 px-4 py-2 text-sm font-semibold text-red-600 hover:bg-red-100 transition cursor-pointer" %>
      </div>
    <% end %>
  </div>

  <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-6 mb-6 space-y-4">
    <div>
      <h2 class="text-sm font-bold text-gray-400 uppercase tracking-wide"><%= t("assignments.show.instructions_heading") %></h2>
      <p class="text-sm text-gray-700 mt-1 whitespace-pre-wrap"><%= @assignment.description.presence || t("assignments.show.no_instructions") %></p>
    </div>

    <% if @assignment.file.attached? %>
      <div class="bg-blue-50 border border-blue-200 rounded-xl p-4 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div class="flex items-center gap-3">
          <svg class="w-10 h-10 text-blue-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
          </svg>
          <div>
            <h3 class="text-sm font-semibold text-blue-900"><%= t("assignments.show.document_title") %></h3>
            <p class="text-xs text-blue-700"><%= t("assignments.show.document_hint") %></p>
          </div>
        </div>
        <%= link_to t("assignments.show.download_button"), rails_blob_path(@assignment.file, disposition: "attachment"), class: "inline-flex items-center gap-2 px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-xs font-semibold rounded-lg shadow-sm shrink-0", target: "_blank" %>
      </div>
    <% end %>
  </div>

  <% if Current.user.student? %>
    <%= turbo_stream_from "assignment_#{@assignment.id}_user_#{Current.user.id}" %>
    <% if @submitted %>
      <%= render partial: "assignments/student_submission", locals: { submission: @submission, assignment: @assignment } %>
    <% elsif @assignment.locked? %>
      <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-8 text-center">
        <svg class="w-12 h-12 text-amber-500 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
        </svg>
        <p class="text-gray-700 font-semibold"><%= t("assignments.show.locked_title") %></p>
        <p class="text-sm text-gray-500 mt-1"><%= t("assignments.show.locked_hint") %></p>
      </div>
    <% elsif @assignment.closed? %>
      <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-8 text-center">
        <svg class="w-12 h-12 text-orange-500 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"></path>
        </svg>
        <p class="text-gray-700 font-semibold"><%= t("assignments.show.closed_title") %></p>
        <p class="text-sm text-gray-500 mt-1"><%= t("assignments.show.closed_hint") %></p>
      </div>
    <% elsif @assignment.due_at < Time.current %>
      <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-8 text-center">
        <svg class="w-12 h-12 text-red-400 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
        </svg>
        <p class="text-gray-700 font-semibold"><%= t("assignments.show.past_due_title") %></p>
        <p class="text-sm text-gray-500 mt-1"><%= t("assignments.show.past_due_hint", date: l(@assignment.due_at, format: :long)) %></p>
      </div>
    <% else %>
      <%= form_with model: [ @subject, @assignment, @new_submission ], class: "bg-white rounded-xl border border-gray-200 shadow-sm p-6 space-y-6" do |f| %>
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-gray-100 pb-4" data-controller="countdown" data-countdown-due-at-value="<%= @assignment.due_at.iso8601 %>">
          <p class="text-sm text-gray-600"><%= t("assignments.show.submit_instruction") %></p>
          <div class="flex items-center gap-1.5 bg-red-50 text-red-700 px-3 py-1 rounded-lg border border-red-200 text-xs font-semibold self-start sm:self-auto">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <span data-countdown-target="timer">--:--:--</span>
          </div>
        </div>
        
        <div class="space-y-4">
          <div class="bg-gray-50 p-6 rounded-xl border-2 border-dashed border-gray-300 text-center">
            <svg class="w-8 h-8 text-gray-400 mx-auto mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"></path>
            </svg>
            <%= f.file_field :file, required: true, class: "hidden", id: "assignment-file-input", data: { selected_template: t("chats.files_selected", count: "%{count}"), placeholder: t("common.no_file_chosen") }, onchange: "let label = document.getElementById('assignment-file-label'); if(this.files.length > 0) { label.innerText = this.getAttribute('data-selected-template').replace('%{count}', this.files.length); } else { label.innerText = this.getAttribute('data-placeholder'); }" %>
            <div class="flex flex-col items-center gap-2 mt-2">
              <label for="assignment-file-input" class="py-1.5 px-4 rounded-md border border-gray-300 text-xs font-semibold bg-white text-gray-700 hover:bg-gray-50 cursor-pointer shadow-sm">
                <%= t("common.choose_file") %>
              </label>
              <span id="assignment-file-label" data-placeholder="<%= t("common.no_file_chosen") %>" class="text-[11px] text-gray-500"><%= t("common.no_file_chosen") %></span>
            </div>
            <p class="text-xxs text-gray-400 mt-2"><%= t("assignments.show.accepted_formats") %></p>
          </div>
        </div>

        <div class="flex justify-end pt-4 border-t border-gray-100">
          <%= f.submit t("assignments.show.submit_button"), class: "px-6 py-2.5 text-sm font-semibold text-white bg-blue-600 rounded-lg hover:bg-blue-700 shadow-sm cursor-pointer", data: { turbo_confirm: t("assignments.show.confirm_submit") } %>
        </div>
      <% end %>
    <% end %>
  <% end %>
</div>
