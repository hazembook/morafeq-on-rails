<div class="max-w-2xl mx-auto px-4 py-6">
  <div class="mb-6">
    <%= link_to t("assignments.new.back"), subject_path(@subject), class: "text-sm text-blue-600 hover:text-blue-800" %>
    <h1 class="text-2xl font-bold mt-2 text-gray-900"><%= t("assignments.new.title") %></h1>
    <p class="text-sm text-gray-500"><%= @subject.name %> (<%= @subject.code %>)</p>
  </div>

  <%= form_with model: [ @subject, @assignment ], class: "bg-white rounded-xl border border-gray-200 shadow-sm p-6 space-y-6" do |f| %>
    <% if @assignment.errors.any? %>
      <div class="bg-red-50 text-red-700 p-4 rounded-lg text-sm border border-red-200">
        <h3 class="font-semibold mb-1"><%= t("assignments.new.errors_title") %></h3>
        <ul class="list-disc list-inside">
          <% @assignment.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <%= f.label :title, t("assignments.new.title_label"), class: "block text-sm font-semibold text-gray-700 mb-1" %>
      <%= f.text_field :title, placeholder: t("assignments.new.title_placeholder"), required: true, class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm" %>
    </div>

    <div>
      <%= f.label :description, t("assignments.new.description_label"), class: "block text-sm font-semibold text-gray-700 mb-1" %>
      <%= f.text_area :description, rows: 4, placeholder: t("assignments.new.description_placeholder"), class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm" %>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div>
        <%= f.label :due_at, t("assignments.new.due_label"), class: "block text-sm font-semibold text-gray-700 mb-1" %>
        <%= f.datetime_local_field :due_at, required: true, class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm" %>
      </div>

      <div>
        <%= f.label :total_points, t("assignments.new.points_label"), class: "block text-sm font-semibold text-gray-700 mb-1" %>
        <%= f.number_field :total_points, value: f.object.total_points || 100, required: true, class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm" %>
      </div>
    </div>

    <div class="bg-blue-50 p-4 rounded-xl border border-blue-100">
      <%= f.label :file, t("assignments.new.file_label"), class: "block text-xs font-semibold text-blue-900 uppercase tracking-wide mb-1.5" %>
      <div class="flex items-center gap-3">
        <%= f.file_field :file, class: "hidden", id: "assignment-new-file-input", data: { selected_template: t("chats.files_selected", count: "%{count}"), placeholder: t("common.no_file_chosen") }, onchange: "let label = document.getElementById('assignment-new-file-label'); if(this.files.length > 0) { label.innerText = this.getAttribute('data-selected-template').replace('%{count}', this.files.length); } else { label.innerText = this.getAttribute('data-placeholder'); }" %>
        <label for="assignment-new-file-input" class="py-1.5 px-4 rounded-md border border-gray-300 text-xs font-semibold bg-white text-gray-700 hover:bg-gray-50 cursor-pointer shadow-sm">
          <%= t("common.choose_file") %>
        </label>
        <span id="assignment-new-file-label" data-placeholder="<%= t("common.no_file_chosen") %>" class="text-xs text-gray-500"><%= t("common.no_file_chosen") %></span>
      </div>
      <p class="text-[10px] text-blue-700 mt-1.5"><%= t("assignments.new.file_hint") %></p>
    </div>

    <div class="flex justify-end gap-3 border-t border-gray-100 pt-6">
      <%= link_to t("common.cancel"), subject_path(@subject), class: "px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50" %>
      <%= f.submit t("assignments.new.create_button"), class: "px-6 py-2.5 text-sm font-semibold text-white bg-blue-600 rounded-lg hover:bg-blue-700 shadow-sm cursor-pointer" %>
    </div>
  <% end %>
</div>
