<div class="max-w-2xl mx-auto px-4 py-6">
  <div class="mb-6">
    <%= link_to "← Back to Subject", subject_path(@subject), class: "text-sm text-blue-600 hover:text-blue-800" %>
    <h1 class="text-2xl font-bold mt-2 text-gray-900">Create a New Assignment</h1>
    <p class="text-sm text-gray-500"><%= @subject.name %> (<%= @subject.code %>)</p>
  </div>

  <%= form_with model: [ @subject, @assignment ], class: "bg-white rounded-xl border border-gray-200 shadow-sm p-6 space-y-6" do |f| %>
    <% if @assignment.errors.any? %>
      <div class="bg-red-50 text-red-700 p-4 rounded-lg text-sm border border-red-200">
        <h3 class="font-semibold mb-1">Errors prevented this assignment from being saved:</h3>
        <ul class="list-disc list-inside">
          <% @assignment.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <%= f.label :title, "Assignment Title", class: "block text-sm font-semibold text-gray-700 mb-1" %>
      <%= f.text_field :title, placeholder: "e.g. Homework 1, Term Paper Draft", required: true, class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm" %>
    </div>

    <div>
      <%= f.label :description, "Instructions / Description", class: "block text-sm font-semibold text-gray-700 mb-1" %>
      <%= f.text_area :description, rows: 4, placeholder: "Type assignment description or instructions here...", class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm" %>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div>
        <%= f.label :due_at, "Due Date & Time", class: "block text-sm font-semibold text-gray-700 mb-1" %>
        <%= f.datetime_local_field :due_at, required: true, class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm" %>
      </div>

      <div>
        <%= f.label :total_points, "Points Value", class: "block text-sm font-semibold text-gray-700 mb-1" %>
        <%= f.number_field :total_points, value: f.object.total_points || 100, required: true, class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm" %>
      </div>
    </div>

    <div class="bg-blue-50 p-4 rounded-xl border border-blue-100">
      <%= f.label :file, "Attach Worksheet / Instruction Document (Optional)", class: "block text-xs font-semibold text-blue-900 uppercase tracking-wide mb-1" %>
      <%= f.file_field :file, class: "w-full rounded-lg border border-gray-300 bg-white shadow-sm text-sm p-1.5 focus:border-blue-500 focus:ring-blue-500 cursor-pointer" %>
      <p class="text-[10px] text-blue-700 mt-1">Attach a PDF, DOCX, or PPT file for students to download and solve.</p>
    </div>

    <div class="flex justify-end gap-3 border-t border-gray-100 pt-6">
      <%= link_to "Cancel", subject_path(@subject), class: "px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50" %>
      <%= f.submit "Create Assignment", class: "px-6 py-2.5 text-sm font-semibold text-white bg-blue-600 rounded-lg hover:bg-blue-700 shadow-sm cursor-pointer" %>
    </div>
  <% end %>
</div>
