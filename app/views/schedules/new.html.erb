<div class="max-w-xl mx-auto px-4 py-6">
  <div class="mb-6">
    <%= link_to t("schedules.new.back"), subject_schedules_path(@subject), class: "text-sm text-blue-600 hover:text-blue-800" %>
    <h1 class="text-2xl font-bold mt-2 text-gray-900"><%= t("schedules.new.title") %></h1>
    <p class="text-sm text-gray-500"><%= @subject.name %> (<%= @subject.code %>)</p>
  </div>

  <%= form_with model: [ @subject, @schedule ], class: "bg-white rounded-xl border border-gray-200 shadow-sm p-6 space-y-5" do |f| %>
    <% if @schedule.errors.any? %>
      <div class="bg-red-50 text-red-700 p-4 rounded-lg text-sm border border-red-200">
        <h3 class="font-semibold mb-1"><%= t("schedules.new.errors_title") %></h3>
        <ul class="list-disc list-inside">
          <% @schedule.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <%= f.label :day, t("schedules.new.day_label"), class: "block text-sm font-semibold text-gray-700 mb-1" %>
      <%= f.select :day, [[t("subjects.days.sunday"), 0], [t("subjects.days.monday"), 1], [t("subjects.days.tuesday"), 2], [t("subjects.days.wednesday"), 3], [t("subjects.days.thursday"), 4], [t("subjects.days.friday"), 5], [t("subjects.days.saturday"), 6]], {}, class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm" %>
    </div>

    <div class="grid grid-cols-2 gap-4">
      <div>
        <%= f.label :start_time, t("schedules.new.start_time_label"), class: "block text-sm font-semibold text-gray-700 mb-1" %>
        <%= f.time_field :start_time, class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm" %>
      </div>
      <div>
        <%= f.label :end_time, t("schedules.new.end_time_label"), class: "block text-sm font-semibold text-gray-700 mb-1" %>
        <%= f.time_field :end_time, class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm" %>
      </div>
    </div>

    <div>
      <%= f.label :room, t("schedules.new.room_label"), class: "block text-sm font-semibold text-gray-700 mb-1" %>
      <%= f.text_field :room, placeholder: t("schedules.new.room_placeholder"), class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm" %>
    </div>

    <div class="flex justify-end gap-3 pt-4 border-t border-gray-100">
      <%= link_to t("common.cancel"), subject_schedules_path(@subject), class: "px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50" %>
      <%= f.submit t("schedules.new.create_button"), class: "px-4 py-2 text-sm font-semibold text-white bg-blue-600 rounded-lg hover:bg-blue-700 shadow-sm cursor-pointer" %>
    </div>
  <% end %>
</div>
