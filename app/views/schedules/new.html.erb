<div class="max-w-xl mx-auto px-4 py-6">
  <div class="mb-6">
    <%= link_to "← Back to Schedule", subject_schedules_path(@subject), class: "text-sm text-blue-600 hover:text-blue-800" %>
    <h1 class="text-2xl font-bold mt-2 text-gray-900">Add Schedule Entry</h1>
    <p class="text-sm text-gray-500"><%= @subject.name %> (<%= @subject.code %>)</p>
  </div>

  <%= form_with model: [ @subject, @schedule ], class: "bg-white rounded-xl border border-gray-200 shadow-sm p-6 space-y-5" do |f| %>
    <% if @schedule.errors.any? %>
      <div class="bg-red-50 text-red-700 p-4 rounded-lg text-sm border border-red-200">
        <h3 class="font-semibold mb-1">Errors prevented this schedule entry from being saved:</h3>
        <ul class="list-disc list-inside">
          <% @schedule.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <%= f.label :day, "Day of the Week", class: "block text-sm font-semibold text-gray-700 mb-1" %>
      <%= f.select :day, [["Sunday", 0], ["Monday", 1], ["Tuesday", 2], ["Wednesday", 3], ["Thursday", 4], ["Friday", 5], ["Saturday", 6]], {}, class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm" %>
    </div>

    <div class="grid grid-cols-2 gap-4">
      <div>
        <%= f.label :start_time, "Start Time", class: "block text-sm font-semibold text-gray-700 mb-1" %>
        <%= f.time_field :start_time, class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm" %>
      </div>
      <div>
        <%= f.label :end_time, "End Time", class: "block text-sm font-semibold text-gray-700 mb-1" %>
        <%= f.time_field :end_time, class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm" %>
      </div>
    </div>

    <div>
      <%= f.label :room, "Room / Location", class: "block text-sm font-semibold text-gray-700 mb-1" %>
      <%= f.text_field :room, placeholder: "e.g. Hall 4, Lab C", class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm" %>
    </div>

    <div class="flex justify-end gap-3 pt-4 border-t border-gray-100">
      <%= link_to "Cancel", subject_schedules_path(@subject), class: "px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50" %>
      <%= f.submit "Create Entry", class: "px-4 py-2 text-sm font-semibold text-white bg-blue-600 rounded-lg hover:bg-blue-700 shadow-sm cursor-pointer" %>
    </div>
  <% end %>
</div>
