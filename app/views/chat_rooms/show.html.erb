<div class="max-w-3xl mx-auto">
  <div class="mb-4">
    <%= link_to "← Back to Chats", chat_rooms_path, class: "text-sm text-blue-600 hover:text-blue-800" %>
    <h1 class="text-xl font-bold mt-1"><%= @room.name %></h1>
  </div>

  <div class="bg-white rounded-lg shadow mb-4">
    <div id="messages" class="h-96 overflow-y-auto p-4 space-y-3">
      <%= render @messages %>
    </div>

    <%= form_with model: [@room, Message.new], class: "border-t border-gray-200 p-4 flex gap-2" do |f| %>
      <%= f.text_field :content, placeholder: "Type a message...", class: "flex-1 rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500", autocomplete: "off" %>
      <%= f.submit "Send", class: "rounded-md bg-blue-600 px-4 py-2 text-white text-sm font-medium hover:bg-blue-700" %>
    <% end %>
  </div>
</div>

<%= turbo_stream_from "chat_room_#{@room.id}" %>
