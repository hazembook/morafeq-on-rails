<% content_for :body_class, "h-dvh overflow-hidden flex flex-col" %>
<% content_for :body_style, "padding-bottom: 0;" %>
<% content_for :main_class, "fixed inset-0 h-dvh w-screen overflow-hidden flex flex-col bg-gray-50 z-40 pt-0 md:pt-16 pb-[calc(4rem+env(safe-area-inset-bottom,0px))] md:pb-0" %>

<div class="flex-1 flex overflow-hidden min-h-0 w-full">
  
  <!-- Sidebar Pane (Hidden on mobile show) -->
  <div class="hidden md:flex w-full md:w-80 lg:w-96 flex-col shrink-0 min-h-0 border-e border-gray-200">
    <%= render "sidebar" %>
  </div>

  <!-- Active Chat Window (Takes full width on mobile, flex-1 on desktop) -->
  <div class="flex flex-1 flex-col bg-[#e7ebf0] overflow-hidden relative min-h-0">
    <!-- Telegram pattern texture background overlay -->
    <div class="absolute inset-0 opacity-[0.05] bg-repeat pointer-events-none" style="background-image: url('data:image/svg+xml,%3Csvg width=\"80\" height=\"80\" viewBox=\"0 0 80 80\" xmlns=\"http://www.w3.org/2000/svg\"%3E%3Cpath d=\"M14 16v4h-2v-4H8v-2h4V8h2v6h6v2h-6zM30 46v4h-2v-4h-4v-2h4v-6h2v6h6v2h-6z\" fill=\"%23000\" fill-opacity=\"1\" fill-rule=\"evenodd\"%3E%3C/path%3E%3C/svg%3E');"></div>

      <!-- Chat Header -->
      <div class="bg-white border-b border-gray-150 p-4 flex items-center justify-between shrink-0 z-10 shadow-sm">
        <div class="flex items-center gap-3 min-w-0">
          <!-- Back button on mobile -->
          <%= link_to chat_rooms_path, class: "md:hidden p-1.5 hover:bg-gray-100 rounded-full text-gray-500 hover:text-gray-800 transition-colors shrink-0" do %>
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="<%= I18n.locale == :ar ? 'M9 5l7 7-7 7' : 'M15 19l-7-7 7-7' %>"></path>
            </svg>
          <% end %>
          
          <% 
            display_name = @room.display_name(Current.user)
            initials = if @room.is_private?
              other = @room.participants.where.not(id: Current.user.id).first
              other ? other.full_name.split.map(&:first).join("").first(2).upcase : "ME"
            else
              @room.subject ? @room.subject.code.first(4) : @room.name.first(2).upcase
            end
            gradients = [
              "from-blue-500 to-indigo-600",
              "from-emerald-400 to-teal-600",
              "from-purple-500 to-pink-600",
              "from-amber-500 to-orange-600",
              "from-rose-500 to-red-600"
            ]
            gradient = gradients[@room.id % gradients.size]
          %>
          
          <div class="w-10 h-10 rounded-full bg-gradient-to-tr <%= gradient %> flex items-center justify-center text-white text-xs font-semibold tracking-wider shadow-inner shrink-0 select-none">
            <%= initials %>
          </div>
          
          <div class="min-w-0">
            <h1 class="text-sm font-bold text-gray-900 truncate"><%= display_name %></h1>
            <p class="text-[10px] text-gray-400">
              <% if @room.is_private? %>
                <%= t("chats.private_message", default: "Private Conversation") %>
              <% else %>
                <%= t("chats.class_chat", code: @room.subject&.code, default: "Class Room") %> &middot; <%= t("chats.members_count", count: @room.participants.count, default: "%{count} participants") %>
              <% end %>
            </p>
          </div>
        </div>
      </div>

      <!-- Chat Messages Scroll Pane -->
      <div id="messages" data-controller="chat-scroll" class="flex-1 overflow-y-auto p-4 space-y-3.5 z-10">
        <%= render @messages %>
      </div>

      <!-- Typing Indicator -->
      <div id="typing_indicator" class="text-xs text-gray-500 bg-white/70 backdrop-blur-sm px-4 py-1 min-h-[1.5rem] transition-opacity duration-300 z-10 border-t border-gray-100/50"></div>

      <!-- Chat Input Form -->
      <%= form_with model: [ @room, Message.new ], class: "bg-white border-t border-gray-150 p-3 sm:p-4 relative z-10 shrink-0 shadow-lg", data: { controller: "chat-typing chat-file-preview", chat_typing_room_id_value: @room.id, chat_typing_url_value: typing_chat_room_path(@room) } do |f| %>
        <!-- File preview strip -->
        <div data-chat-file-preview-target="preview" class="flex flex-wrap gap-2 mb-2 hidden"></div>

        <div class="flex items-center gap-2 sm:gap-3">
          <%= f.file_field :attachments, multiple: true, class: "hidden", id: "chat-file-input", data: { chat_file_preview_target: "input", action: "change->chat-file-preview#preview" } %>
          
          <label for="chat-file-input" class="p-2 text-gray-400 hover:text-gray-600 hover:bg-gray-100 rounded-full cursor-pointer flex items-center justify-center transition-colors shrink-0" title="<%= t("chats.attach_files") %>">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13"></path>
            </svg>
          </label>

          <%= f.text_field :content, placeholder: t("chats.placeholder"), class: "flex-1 rounded-2xl border-gray-300 shadow-inner bg-gray-50 focus:bg-white focus:border-blue-500 focus:ring-blue-500 text-sm py-2 px-4 transition-all duration-200", autocomplete: "off", data: { action: "input->chat-typing#typing" } %>
          
          <button type="submit" class="w-10 h-10 bg-blue-500 hover:bg-blue-600 text-white rounded-full flex items-center justify-center transition-all duration-150 hover:scale-105 shrink-0 cursor-pointer shadow-md border-0">
            <svg class="w-5 h-5 translate-x-[2px] rtl:-translate-x-[2px] -translate-y-[1px]" fill="currentColor" viewBox="0 0 20 20">
              <path d="M10.894 2.553a1 1 0 00-1.788 0l-7 14a1 1 0 001.169 1.409l5-1.429A1 1 0 009 15.571V11a1 1 0 112 0v4.571a1 1 0 00.725.962l5 1.428a1 1 0 001.17-1.408l-7-14z"></path>
            </svg>
          </button>
        </div>
      <% end %>
    </div>

  </div>

<%= turbo_stream_from "chat_room_#{@room.id}" %>
