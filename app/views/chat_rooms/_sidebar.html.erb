<div class="flex flex-col h-full bg-white border-e border-gray-200" data-controller="chat-search">
  <div class="p-4 border-b border-gray-100 space-y-3">
    <div class="flex items-center justify-between">
      <h1 class="text-xl font-bold text-gray-900 flex items-center gap-2">
        <svg class="w-6 h-6 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
        </svg>
        <%= t("chats.title") %>
      </h1>
    </div>
    
    <div class="relative">
      <span class="absolute inset-y-0 start-0 flex items-center ps-3 pointer-events-none text-gray-400">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
      </span>
      <input type="text" 
             data-chat-search-target="input" 
             data-action="input->chat-search#filter" 
             placeholder="<%= t("chats.search_placeholder", default: "Search chats or users...") %>" 
             class="w-full ps-9 pe-4 py-2 rounded-lg border-0 bg-gray-100 focus:bg-white focus:ring-2 focus:ring-blue-500 text-sm placeholder-gray-400 transition-all duration-200">
    </div>

    <div class="flex gap-1 bg-gray-100 p-0.5 rounded-lg">
      <button type="button" 
              data-chat-search-target="tab"
              data-action="click->chat-search#changeTab" 
              data-tab="all" 
              class="flex-1 py-1.5 text-xs font-semibold rounded-md text-center bg-white text-blue-600 shadow-sm transition-all duration-200 focus:outline-none cursor-pointer">
        <%= t("chats.tabs.all", default: "All") %>
      </button>
      <button type="button" 
              data-chat-search-target="tab"
              data-action="click->chat-search#changeTab" 
              data-tab="group" 
              class="flex-1 py-1.5 text-xs font-semibold rounded-md text-center text-gray-600 hover:text-gray-900 transition-all duration-200 focus:outline-none cursor-pointer">
        <%= t("chats.tabs.classes", default: "Classes") %>
      </button>
      <button type="button" 
              data-chat-search-target="tab"
              data-action="click->chat-search#changeTab" 
              data-tab="private" 
              class="flex-1 py-1.5 text-xs font-semibold rounded-md text-center text-gray-600 hover:text-gray-900 transition-all duration-200 focus:outline-none cursor-pointer">
        <%= t("chats.tabs.dms", default: "DMs") %>
      </button>
    </div>
  </div>

  <div class="flex-1 overflow-y-auto">
    <%= turbo_stream_from "unread_#{Current.user.id}" %>
    <%= render partial: "sidebar_room", collection: @rooms, as: :room, locals: { user: Current.user, current_room: @room } %>

    <div data-chat-search-target="usersHeader" class="px-4 py-2 text-xs font-bold text-gray-400 bg-gray-50/50 uppercase tracking-wider hidden">
      <%= t("chats.start_new_chat", default: "Contacts") %>
    </div>
    
    <div class="space-y-0.5">
      <% @users.each do |user| %>
        <% 
          initials = user.full_name.split.map(&:first).join("").first(2).upcase
          gradients = [
            "from-blue-500 to-indigo-600",
            "from-emerald-400 to-teal-600",
            "from-purple-500 to-pink-600",
            "from-amber-500 to-orange-600",
            "from-rose-500 to-red-600"
          ]
          gradient = gradients[user.id % gradients.size]
        %>
        <div data-chat-search-target="user" data-search-name="<%= user.full_name %>" class="hidden">
          <%= button_to create_private_chat_rooms_path(user_id: user.id), method: :post, class: "w-full text-start flex items-center gap-3 px-4 py-3 hover:bg-gray-50 transition-colors duration-150 cursor-pointer border-0 bg-transparent" do %>
            <div class="w-10 h-10 rounded-full bg-gradient-to-tr <%= gradient %> flex items-center justify-center text-white text-xs font-semibold tracking-wider shadow-inner shrink-0 select-none">
              <%= initials %>
            </div>
            <div class="flex-1 min-w-0">
              <h3 class="text-sm font-bold text-gray-900 truncate"><%= user.full_name %></h3>
              <p class="text-xs text-gray-400 capitalize"><%= t("roles.#{user.role}") %></p>
            </div>
            <div class="text-xs font-semibold text-blue-600 hover:text-blue-700 bg-blue-50 px-2.5 py-1 rounded">
              <%= t("chats.chat_button") %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>
