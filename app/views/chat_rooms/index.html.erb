<div class="max-w-5xl mx-auto px-4 py-6">
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    <!-- Chats List -->
    <div class="md:col-span-2">
      <h1 class="text-2xl font-bold text-gray-900 mb-6 flex items-center gap-2">
        <svg class="w-7 h-7 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
        </svg>
        Your Conversations
      </h1>

      <% if @rooms.any? %>
        <div class="space-y-3">
          <% @rooms.each do |room| %>
            <%= link_to room, class: "block bg-white rounded-xl shadow-sm border border-gray-100 p-4 hover:shadow-md hover:border-blue-100 transition-all duration-200" do %>
              <div class="flex items-center justify-between">
                <div>
                  <p class="font-semibold text-gray-900"><%= room.display_name(Current.user) %></p>
                  <p class="text-xs text-gray-500 mt-1 flex items-center gap-1.5">
                    <% if room.is_private? %>
                      <span class="inline-block w-2 h-2 rounded-full bg-blue-500"></span>
                      Private Message
                    <% else %>
                      <span class="inline-block w-2 h-2 rounded-full bg-green-500"></span>
                      Class Chat • <%= room.subject&.code %>
                    <% end %>
                  </p>
                </div>
                <div class="text-blue-500">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                  </svg>
                </div>
              </div>
            <% end %>
          <% end %>
        </div>
      <% else %>
        <div class="bg-white rounded-xl border border-gray-200 p-12 text-center shadow-sm">
          <svg class="w-12 h-12 text-gray-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
          </svg>
          <p class="text-gray-500 font-medium">No active chats yet.</p>
          <p class="text-xs text-gray-400 mt-1">Start a conversation from the list on the right or via a post!</p>
        </div>
      <% end %>
    </div>

    <!-- Start a Conversation Column -->
    <div>
      <h2 class="text-xl font-bold text-gray-900 mb-6 flex items-center gap-2">
        <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
        </svg>
        Start a Chat
      </h2>

      <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-4 max-h-[70vh] overflow-y-auto">
        <% if @users.any? %>
          <div class="space-y-2">
            <% @users.each do |user| %>
              <div class="flex items-center justify-between p-2 rounded-lg hover:bg-gray-50 transition-colors">
                <div class="min-w-0 flex-1 pr-2">
                  <p class="font-medium text-sm text-gray-800 truncate"><%= user.full_name %></p>
                  <p class="text-xs text-gray-400 capitalize"><%= user.role %></p>
                </div>
                <%= button_to "Chat", create_private_chat_rooms_path(user_id: user.id), method: :post, class: "px-3 py-1.5 text-xs font-semibold text-white bg-blue-600 hover:bg-blue-700 rounded-md transition-colors shadow-sm cursor-pointer shrink-0" %>
              </div>
            <% end %>
          </div>
        <% else %>
          <p class="text-xs text-gray-500 text-center py-4">No other users found.</p>
        <% end %>
      </div>
    </div>
  </div>
</div>
