<div class="max-w-3xl mx-auto">
  <h1 class="text-2xl font-bold mb-6">Chats</h1>

  <% if @rooms.any? %>
    <div class="space-y-2">
      <% @rooms.each do |room| %>
        <%= link_to room, class: "block bg-white rounded-lg shadow p-4 hover:bg-gray-50" do %>
          <p class="font-medium"><%= room.name %></p>
          <p class="text-xs text-gray-400"><%= room.subject&.code %></p>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <div class="bg-white rounded-lg shadow p-8 text-center">
      <p class="text-gray-500">No chats available.</p>
    </div>
  <% end %>
</div>
