<div class="max-w-6xl mx-auto px-2 sm:px-4 py-2 sm:py-6">
  <div class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden flex h-[calc(100vh-160px)] min-h-[500px]">
    
    <!-- Sidebar Pane (List of Chats) -->
    <div class="w-full md:w-80 lg:w-96 flex flex-col shrink-0">
      <%= render "sidebar" %>
    </div>

    <!-- Active Chat / Placeholder Pane (Hidden on mobile) -->
    <div class="hidden md:flex flex-1 flex-col bg-[#e7ebf0] justify-center items-center p-8 text-center select-none relative">
      <!-- Telegram pattern texture background overlay -->
      <div class="absolute inset-0 opacity-[0.05] bg-repeat pointer-events-none" style="background-image: url('data:image/svg+xml,%3Csvg width=\"80\" height=\"80\" viewBox=\"0 0 80 80\" xmlns=\"http://www.w3.org/2000/svg\"%3E%3Cpath d=\"M14 16v4h-2v-4H8v-2h4V8h2v6h6v2h-6zM30 46v4h-2v-4h-4v-2h4v-6h2v6h6v2h-6z\" fill=\"%23000\" fill-opacity=\"1\" fill-rule=\"evenodd\"%3E%3C/path%3E%3C/svg%3E');"></div>
      
      <div class="z-10 max-w-sm space-y-3">
        <div class="w-16 h-16 rounded-full bg-white flex items-center justify-center mx-auto shadow-sm text-blue-500">
          <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
          </svg>
        </div>
        <p class="text-sm font-bold text-gray-500"><%= t("chats.no_chats_hint", default: "Select a chat to start messaging") %></p>
      </div>
    </div>

  </div>
</div>
